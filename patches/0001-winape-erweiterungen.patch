+// Draws the "grayed out" look: every second pixel (checkerboard) of the rectangle gets the background color.
+static void DrawDisabledOverlay(SDL_Surface& Surface, const SDL_Rect& Rect, Uint32 Color)
+{
+  int x0 = std::max(Rect.x, 0), y0 = std::max(Rect.y, 0);
+  int x1 = std::min(Rect.x + Rect.w, Surface.w), y1 = std::min(Rect.y + Rect.h, Surface.h);
+  if (x0 >= x1 || y0 >= y1) {
+    return;
+  }
+  const int bpp = Surface.format->BytesPerPixel;
+  if (SDL_MUSTLOCK(&Surface)) {
+    SDL_LockSurface(&Surface);
+  }
+  for (int y = y0; y < y1; ++y) {
+    Uint8* row = static_cast<Uint8*>(Surface.pixels) + y * Surface.pitch;
+    for (int x = x0 + ((x0 + y) & 1); x < x1; x += 2) {
+      Uint8* px = row + x * bpp;
+      switch (bpp) {
+        case 4: *reinterpret_cast<Uint32*>(px) = Color; break;
+        case 2: *reinterpret_cast<Uint16*>(px) = static_cast<Uint16>(Color); break;
+        case 1: *px = static_cast<Uint8>(Color); break;
+        default: px[0] = Color & 0xff; px[1] = (Color >> 8) & 0xff; px[2] = (Color >> 16) & 0xff; break;
+      }
+    }
+  }
+  if (SDL_MUSTLOCK(&Surface)) {
+    SDL_UnlockSurface(&Surface);
+  }
+}
