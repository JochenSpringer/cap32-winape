+/* Schreib-Abschluss wie AMSDOS: Typ -> Endung, vorhandene Datei -> .BAK, .$$$ -> endgueltiger Name */
+static void finish_write(FD*f){
+  char fin[270]; cpystr(fin,f->base,270);
+  if(f->blankext){ /* "NAME." = leere Endung */ }
+  else if(f->noext){
+    u8 hd[128]; const char*x=""; if(P_seek(f->h,0)==0&&P_read(f->h,hd,128)==128&&has_amsdos_hdr(hd)){ if(hd[18]==0||hd[18]==1) x=".BAS"; else if(hd[18]==2) x=".BIN"; }
+    int n=(int)strlen(fin); for(int i=0;x[i]&&n<266;i++) fin[n++]=x[i]; fin[n]=0;
+  } else cpystr(fin,f->given,270);
+  P_close(f->h); f->h=NULL;
+  char old[260]; int isd; char p1[512],p2[512];
+  if(find_host(f->dir,fin,old,&isd,NULL)&&!isd){
+    int dd=lastdot(old); int isbak=(dd>=0&&eqci(old+dd,".BAK"));
+    joinp(p1,f->dir,old);
+    if(isbak) P_delete(p1);
+    else { char bak[270]; int b0=lastdot(old); int n=0; for(int i=0;i<(b0>0?b0:(int)strlen(old))&&n<262;i++) bak[n++]=old[i]; const char*bx=".BAK"; for(int i=0;bx[i];i++) bak[n++]=bx[i]; bak[n]=0;
