+/* ----- DSK-Image-Unterstuetzung (nur Lesen) ----- */
+static void *dskf; static int dsk_ext, dsk_sides, dsk_nt, dsk_rt, dsk_idb, dsk_nsec; static u32 dsk_toff[170]; static u8 dsk_dir[2048];
+static int dsk_sector(int track,int id,u8*buf){
+  if(track<0||track>=dsk_nt) return -1; u32 to=dsk_toff[track*dsk_sides]; if(!to) return -1;
+  u8 ti[256]; if(P_seek(dskf,to)||P_read(dskf,ti,256)!=256||memcmp(ti,"Track-Info",10)) return -1;
+  int ns=ti[0x15]; if(ns>29) ns=29; u32 doff=to+0x100;
+  for(int i=0;i<ns;i++){ int R=ti[0x18+i*8+2], N=ti[0x18+i*8+3]; u32 len=dsk_ext?(ti[0x18+i*8+6]|(ti[0x18+i*8+7]<<8)):(128u<<N);
+    if(R==id){ u32 rd=len<512?len:512; if(P_seek(dskf,doff)||P_read(dskf,buf,rd)!=(int)rd) return -1; memset(buf+rd,0,512-rd); return 0; }
+    doff+=len; }
