+  m_sGroupName = "M4 Board";
+  CGroupBox* m4 = AddGroup(page, 8, 112, 300, 72, "M4 Board");
+  m_m4 = AddCheck(m4, 11, 2, "Enable M4 Board (ROM in slot 6)", CPC.m4 == 1);
+  AddLabel(m4, 6, 22, "ROM:");
+  m_pM4Rom = AddEdit(m4, 40, 19, 230, CPC.m4_rom);
+  AddBrowse(m4, 273, 19, m_pM4Rom, "rom", "Select M4 ROM", "ROM files", "*.rom;*.ROM;*.bin;*.BIN", FileDialogMode::OPEN, CPC.rom_path);
+  AddLabel(m4, 6, 42, "SD:");
+  m_pM4Root = AddEdit(m4, 40, 39, 230, CPC.m4_root);
+  AddBrowse(m4, 273, 39, m_pM4Root, "m4sd", "Select the M4 SD card folder", "Folder", "*", FileDialogMode::FOLDER);
+
+  // ---- Multiface Two ----
+  m_sGroupName = "Multiface Two";
+  CGroupBox* mf2 = AddGroup(page, 316, 8, 288, 55, "Multiface Two");
+  m_multiface = AddCheck(mf2, 11, 14 - GY + 1, "Enable Multiface Two", CPC.mf2 == 1);
+  AddLabel(mf2, 6, 36 - GY + 2, "ROM:");
+  m_pMf2Rom = AddEdit(mf2, 36, 33 - GY + 1, 225, CPC.rom_mf2);
+  AddBrowse(mf2, 263, 33 - GY + 1, m_pMf2Rom, "rom", "Select Multiface 2 ROM", "ROM files", "*.rom;*.ROM;*.bin;*.BIN", FileDialogMode::OPEN, CPC.rom_path);
+  m_sGroupName = "";
