diff --git a/src/pe/src/registry.c b/src/pe/src/registry.c
new file mode 100644
index 0000000..b8dbc30
--- /dev/null
+++ b/src/pe/src/registry.c
@@ -0,0 +1,23 @@
+#include <string.h>
+
+#include "pe/driver.h"
+
+static const pe_driver *const drivers[] = {
+    &pe_driver_p6,
+    &pe_driver_eplq,
+    &pe_driver_lq800,
+    &pe_driver_fx80,
+    &pe_driver_kxp,
+    &pe_driver_lc24,
+    &pe_driver_nlq401,
+    &pe_driver_nlq401d,
+    NULL,
+};
+
+const pe_driver *const *pe_drivers(void) { return drivers; }
+
+const pe_driver *pe_driver_find(const char *id) {
+  for (const pe_driver *const *d = drivers; *d; d++)
+    if (!strcmp((*d)->id, id)) return *d;
+  return NULL;
+}
diff --git a/src/pe/src/util.c b/src/pe/src/util.c
new file mode 100644
index 0000000..8e5e67a
--- /dev/null
+++ b/src/pe/src/util.c
@@ -0,0 +1,26 @@
+#include <stdio.h>
+#include <time.h>
+
+#include "pe/pe.h"
+
+/* "<dir>/<prefix>_YYYYMMDD_HHMMSS.pdf"; "_2", "_3" ... if it already exists. */
+int pe_timestamp_path(char *out, size_t n, const char *dir, const char *prefix) {
+  time_t now = time(NULL);
+  struct tm *tm = localtime(&now);
+  char stamp[32];
+  if (!tm || !strftime(stamp, sizeof stamp, "%Y%m%d_%H%M%S", tm)) return 0;
+  const char *sep = (dir && *dir) ? "/" : "";
+  for (int i = 1; i < 1000; i++) {
+    int len;
+    if (i == 1)
+      len = snprintf(out, n, "%s%s%s_%s.pdf", dir ? dir : "", sep, prefix, stamp);
+    else
+      len = snprintf(out, n, "%s%s%s_%s_%d.pdf", dir ? dir : "", sep, prefix,
+                     stamp, i);
+    if (len < 0 || (size_t)len >= n) return 0;
+    FILE *f = fopen(out, "rb");
+    if (!f) return 1;
+    fclose(f);
+  }
+  return 0;
+}
diff --git a/src/printer_pdf.cpp b/src/printer_pdf.cpp
new file mode 100644
index 0000000..df7d2a5
--- /dev/null
+++ b/src/printer_pdf.cpp
@@ -0,0 +1,194 @@
+#include "printer_pdf.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <iostream>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+extern "C" {
+#include "pe/driver.h"
+#include "pe/pe.h"
+}
+
+namespace {
+
+std::mutex g_mutex;
+std::thread g_worker;
+std::atomic<bool> g_run{false};
+std::atomic<bool> g_active{false};
+
+pe_job* g_job = nullptr;
+const pe_driver* g_drv = nullptr;
+pe_paper g_paper = PE_PAPER_A4;
+std::string g_dir;
+std::string g_last;
+int g_idle_ms = 5000;
+unsigned char g_prev = 0;
+std::chrono::steady_clock::time_point g_last_data;
+std::vector<std::uint8_t> g_pending;
+
+// g_mutex must be held
+void flush_pending_locked() {
+   if (g_job && !g_pending.empty()) {
+      pe_job_write(g_job, g_pending.data(), g_pending.size());
+      g_pending.clear();
+   }
+}
+
+// g_mutex must be held
+int close_job_locked() {
+   int pages = 0;
+   if (g_job) {
+      flush_pending_locked();
+      pages = pe_job_finish(g_job);
+      g_job = nullptr;
+   }
+   return pages;
+}
+
+// g_mutex must be held
+bool open_job_locked() {
+   char path[600];
+   if (!pe_timestamp_path(path, sizeof(path), g_dir.c_str(), "CPC")) {
+      std::cerr << "PDF printer: output path too long: " << g_dir << std::endl;
+      return false;
+   }
+   pe_config pc;
+   pe_config_init(&pc, g_paper);
+   pc.compress = 1;
+   g_job = pe_job_create(g_drv, &pc, path);
+   if (!g_job) {
+      std::cerr << "PDF printer: cannot create " << path << std::endl;
+      return false;
+   }
+   g_last = path;
+   return true;
+}
+
+void worker() {
+   while (g_run) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(250));
+      std::lock_guard<std::mutex> lock(g_mutex);
+      if (g_job) {
+         flush_pending_locked();
+         auto idle = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - g_last_data).count();
+         if (idle >= g_idle_ms) {
+            close_job_locked();
+         }
+      }
+   }
+}
+
+} // namespace
+
+int pdfprinter_model_count() {
+   int n = 0;
+   for (const pe_driver* const* d = pe_drivers(); d && *d; ++d) {
+      ++n;
+   }
+   return n;
+}
+
+const char* pdfprinter_model_id(int index) {
+   return pe_drivers()[index]->id;
+}
+
+const char* pdfprinter_model_name(int index) {
+   return pe_drivers()[index]->name;
+}
+
+namespace {
+const struct { const char* id; const char* name; } g_papers[] = {
+   { "a4", "A4 single sheet" },
+   { "fanfold", "Fanfold 12\"x240 mm" },
+   { "green", "Fanfold, green bars" },
+};
+}
+
+int pdfprinter_paper_count() {
+   return static_cast<int>(sizeof(g_papers) / sizeof(g_papers[0]));
+}
+
+const char* pdfprinter_paper_id(int index) {
+   return g_papers[index].id;
+}
+
+const char* pdfprinter_paper_name(int index) {
+   return g_papers[index].name;
+}
+
+bool pdfprinter_start(const t_pdfprinter_config& cfg) {
+   pdfprinter_stop();
+   const pe_driver* drv = pe_driver_find(cfg.model.c_str());
+   if (!drv) {
+      std::cerr << "PDF printer: unknown printer model '" << cfg.model << "' (p6, eplq, lq800, fx80, kxp2023, lc24, nlq401, nlq401d)" << std::endl;
+      return false;
+   }
+   pe_paper paper;
+   if (cfg.paper == "a4") {
+      paper = PE_PAPER_A4;
+   } else if (cfg.paper == "fanfold") {
+      paper = PE_PAPER_A4_ENDLOS;
+   } else if (cfg.paper == "green") {
+      paper = PE_PAPER_A4_ENDLOS_GRUEN;
+   } else {
+      std::cerr << "PDF printer: unknown paper '" << cfg.paper << "' (a4, fanfold, green)" << std::endl;
+      return false;
+   }
+   std::error_code ec;
+   std::filesystem::create_directories(cfg.dir.empty() ? "." : cfg.dir, ec);
+   {
+      std::lock_guard<std::mutex> lock(g_mutex);
+      g_drv = drv;
+      g_paper = paper;
+      g_dir = cfg.dir.empty() ? "." : cfg.dir;
+      g_idle_ms = (cfg.idle_s < 2 ? 2 : (cfg.idle_s > 3600 ? 3600 : cfg.idle_s)) * 1000;
+      g_prev = 0;
+      g_pending.clear();
+   }
+   g_run = true;
+   g_worker = std::thread(worker);
+   g_active = true;
+   return true;
+}
+
+void pdfprinter_stop() {
+   if (g_worker.joinable()) {
+      g_run = false;
+      g_worker.join();
+   }
+   std::lock_guard<std::mutex> lock(g_mutex);
+   close_job_locked();
+   g_active = false;
+}
+
+bool pdfprinter_active() {
+   return g_active;
+}
+
+void pdfprinter_port_write(unsigned char val, bool bit8) {
+   std::lock_guard<std::mutex> lock(g_mutex);
+   const bool strobe = (val & 0x80) != 0 && (g_prev & 0x80) == 0;
+   g_prev = val;
+   if (!strobe) {
+      return;
+   }
+   if (!g_job && !open_job_locked()) {
+      return;
+   }
+   g_pending.push_back(static_cast<std::uint8_t>((val & 0x7F) | (bit8 ? 0x80 : 0)));
+   g_last_data = std::chrono::steady_clock::now();
+   if (g_pending.size() >= 256) {
+      flush_pending_locked();
+   }
+}
+
+std::string pdfprinter_last_file() {
+   std::lock_guard<std::mutex> lock(g_mutex);
+   return g_last;
+}
diff --git a/src/printer_pdf.h b/src/printer_pdf.h
new file mode 100644
index 0000000..f6384d3
--- /dev/null
+++ b/src/printer_pdf.h
@@ -0,0 +1,38 @@
+/* PDF printer emulation for Caprice32.
+ *
+ * Renders the data stream sent to the CPC printer port into PDF files with the "pe" printer engine
+ * (the same engine as in the Hatari and WinApe projects). One print job = one PDF file
+ * "CPC_YYYYMMDD_HHMMSS.pdf"; a job ends after a configurable number of idle seconds, when the
+ * emulator stops the printer, or on exit.
+ */
+#ifndef PRINTER_PDF_H
+#define PRINTER_PDF_H
+
+#include <string>
+
+struct t_pdfprinter_config {
+   std::string model = "p6";    // p6, eplq, lq800, fx80, kxp2023, lc24, nlq401, nlq401d
+   std::string paper = "a4";    // a4 (single sheet), fanfold (tractor paper), green (green bar tractor paper)
+   std::string dir = ".";       // output folder (created if missing)
+   int idle_s = 5;              // seconds without data until a job (= one PDF file) ends (2..3600)
+};
+
+// Start the PDF printer. Returns false if the configuration is unusable (unknown model or paper).
+bool pdfprinter_start(const t_pdfprinter_config& cfg);
+// Finish an open job and stop the PDF printer.
+void pdfprinter_stop();
+bool pdfprinter_active();
+// Value written to the CPC printer port (&EFxx). The data byte (bits 0-6) is taken on the rising edge of bit 7 (strobe).
+void pdfprinter_port_write(unsigned char val, bool bit8 = false);   // bit8: 8th data bit (8-bit printer hardware mod)
+// Lists for the settings dialog: printer models (id as used in cap32.cfg, display name) and paper types.
+int pdfprinter_model_count();
+const char* pdfprinter_model_id(int index);
+const char* pdfprinter_model_name(int index);
+int pdfprinter_paper_count();
+const char* pdfprinter_paper_id(int index);    // a4, fanfold, green
+const char* pdfprinter_paper_name(int index);
+
+// Path of the PDF file of the current or last job (empty if none yet).
+std::string pdfprinter_last_file();
+
+#endif
diff --git a/src/printer_sound.cpp b/src/printer_sound.cpp
new file mode 100644
index 0000000..8bd3235
--- /dev/null
+++ b/src/printer_sound.cpp
@@ -0,0 +1,98 @@
+#include "printer_sound.h"
+
+#include <SDL.h>
+#include <atomic>
+#include <cstdint>
+#include "cap32.h"
+#include "log.h"
+
+extern "C" {
+extern const int16_t PrinterSound_Data[];
+extern const unsigned PrinterSound_Samples;
+}
+
+extern t_CPC CPC;
+
+namespace {
+
+constexpr Uint32 TAIL_MS = 1500;           // noise continues this long after the last character
+
+SDL_AudioDeviceID device = 0;
+bool openFailed = false;
+bool playing = false;
+Uint32 lastChar = 0;
+std::atomic<unsigned> position{0};
+
+void SDLCALL callback(void*, Uint8* stream, int len)
+{
+  int16_t* out = reinterpret_cast<int16_t*>(stream);
+  const int samples = len / 2;
+  unsigned pos = position.load();
+  for (int i = 0; i < samples; ++i) {
+    out[i] = PrinterSound_Data[pos];
+    if (++pos >= PrinterSound_Samples) pos = 0;     // loop
+  }
+  position.store(pos);
+}
+
+bool Open()
+{
+  if (device != 0) return true;
+  if (openFailed) return false;
+  SDL_AudioSpec want{}, have{};
+  want.freq = 16000;
+  want.format = AUDIO_S16SYS;
+  want.channels = 1;
+  want.samples = 1024;
+  want.callback = callback;
+  device = SDL_OpenAudioDevice(nullptr, 0, &want, &have, SDL_AUDIO_ALLOW_FREQUENCY_CHANGE | SDL_AUDIO_ALLOW_SAMPLES_CHANGE);
+  if (device == 0) {
+    LOG_ERROR("Printer sound: could not open audio: " << SDL_GetError());
+    openFailed = true;
+    return false;
+  }
+  if (have.format != AUDIO_S16SYS || have.channels != 1) {
+    LOG_ERROR("Printer sound: unsupported audio format");
+    SDL_CloseAudioDevice(device);
+    device = 0;
+    openFailed = true;
+    return false;
+  }
+  return true;
+}
+
+} // namespace
+
+void printer_sound_note_char()
+{
+  if (!CPC.printer_sound) return;
+  lastChar = SDL_GetTicks();
+  if (!playing && Open()) {
+    SDL_PauseAudioDevice(device, 0);
+    playing = true;
+  }
+}
+
+void printer_sound_update()
+{
+  if (playing && (!CPC.printer_sound || SDL_GetTicks() - lastChar > TAIL_MS)) {
+    printer_sound_stop();
+  }
+}
+
+void printer_sound_stop()
+{
+  if (playing && device != 0) {
+    SDL_PauseAudioDevice(device, 1);
+  }
+  playing = false;
+}
+
+void printer_sound_shutdown()
+{
+  printer_sound_stop();
+  if (device != 0) {
+    SDL_CloseAudioDevice(device);
+    device = 0;
+  }
+}
diff --git a/src/printer_sound.h b/src/printer_sound.h
new file mode 100644
index 0000000..333874e
--- /dev/null
+++ b/src/printer_sound.h
@@ -0,0 +1,11 @@
+// Printer needle noise (same recording as in Hatari/WinApe): a looped sample that starts with the first
+// character printed and stops 1.5 s after the last one. Played on its own audio device, independent of the CPC sound.
+#ifndef PRINTER_SOUND_H
+#define PRINTER_SOUND_H
+
+void printer_sound_note_char();   // a character reached the printer
+void printer_sound_update();      // call once per frame: stops the noise after the printer went quiet
+void printer_sound_stop();        // stop immediately
+void printer_sound_shutdown();    // close the audio device
+
+#endif
