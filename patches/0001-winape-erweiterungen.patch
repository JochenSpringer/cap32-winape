+  char fname[260]; fname[0]=0; int gt=-1; for(i=0;s[i];i++) if(s[i]=='>') gt=i;
+  if(gt>=0){ int k=0; for(i=gt+1;s[i]&&k<259;i++) fname[k++]=s[i]; fname[k]=0; s[gt]=0; }
+  else { int last=-1; for(i=0;s[i];i++) if(s[i]=='/') last=i; int k=0; for(i=last+1;s[i]&&s[i]!=','&&k<259;i++) fname[k++]=s[i]; fname[k]=0; if(!fname[0]){ fname[0]='i'; fname[1]='n'; fname[2]='d'; fname[3]='e'; fname[4]='x'; fname[5]=0; } }
+  char p[256]; (void)silent; char msg[300]; int m=0;
+  if(!mkpath(fname,p)){ resps(C_HTTPGET,"Invalid filename"); return; }
+  void*fh=P_open(p,FA_WRITE|FA_CREATE_ALWAYS); if(!fh){ resps(C_HTTPGET,"Cannot create file"); return; }
+  Sink sk; sk.fh=fh; sk.total=0; int st=0;
+  UNLOCK(); int r=http_get(s,0,sink_file,&sk,&st); LOCK();
+  P_close(fh);
+  if(r!=0||(st!=200&&st!=206)){ P_delete(p); const char*e=(r==-1)?"Host not found":(r!=0)?"Connection failed":"HTTP error"; resps(C_HTTPGET,e); return; }
+  const char*pre="Downloaded "; while(*pre) msg[m++]=*pre++; char t[12]; int tl=0; u32 v=sk.total; if(!v) t[tl++]='0'; while(v){t[tl++]='0'+v%10;v/=10;} while(tl) msg[m++]=t[--tl]; const char*po=" bytes\r\n"; while(*po) msg[m++]=*po++; msg[m]=0;
+  resps(C_HTTPGET,msg);
+}
+
+/* ---------- Verschiedenes ---------- */
+static void h_time(void){ P_tm t; P_time(&t); char b[32]; int n=0;
+  #define D2(v) do{ b[n++]='0'+((v)/10)%10; b[n++]='0'+(v)%10; }while(0)
+  D2(t.hour); b[n++]=':'; D2(t.min); b[n++]=':'; D2(t.sec); b[n++]=' '; D2(t.year/100); D2(t.year%100); b[n++]='-'; D2(t.mon); b[n++]='-'; D2(t.day); b[n]=0; resps(C_TIME,b); }
+static void h_netstat(void){ static const char s[]="WinAPE host network (M4 emulation)\0"; u8 o[64]; int n=sizeof(s); memcpy(o,s,n); o[n++]=5; respond(C_NETSTAT,o,n); }
+static void h_getnetwork(void){ u8 o[196]; memset(o,0,sizeof o); const char*nm="WINAPE"; for(int i=0;nm[i];i++) o[i]=nm[i]; const char*ss="HOST"; for(int i=0;ss[i];i++) o[16+i]=ss[i]; wr32(o+132,1); o[190]=0x02; o[191]=0x4D; o[192]=0x34; o[193]=0x00; o[194]=0x00; o[195]=0x01; respond(C_GETNETWORK,o,196); }
+static void logcfg(const u8*c,int off,int n){ char b[200]; int k=0; const char*h="0123456789ABCDEF"; const char*t="CONFIG ab "; while(*t) b[k++]=*t++; b[k++]=h[(off>>4)&15]; b[k++]=h[off&15]; b[k++]=':'; for(int i=0;i<n&&i<40&&k<190;i++){ b[k++]=' '; b[k++]=h[c[off+i]>>4]; b[k++]=h[c[off+i]&15]; } b[k++]='\r'; b[k++]='\n'; b[k]=0; P_log(b); }
+static void h_config(void){ u8*d=cmdbuf+3; int dl=cmdlen-3; if(dl<2) { resp1(C_CONFIG,0); return; } u8*c=cfg_buf(); int off=d[0]; int n=dl-1; if(off+n>0x400) n=0x400-off; if(n>0) memcpy(c+off,d+1,n); logcfg(c,off,n); { u8 s[3]={c[0x10],c[0x11],c[0x12]}; logx("AMSDOS-Version F410",s[0]); logx("AMSDOS-ROM    F411",s[1]); logx("BASIC-Version  F412",s[2]); } }
+static void h_romwrite(void){ u8*d=cmdbuf+3; int dl=cmdlen-3; if(dl<5) return; int off=rd16(d), size=rd16(d+2), rom=d[4]; if(rom!=0) return; int avail=dl-5; if(size>avail) size=avail; if(off+size>0x4000) size=0x4000-off; if(size>0) memcpy(g_rom+off,d+5,size); }
+static void h_romcp(void){ u8*d=cmdbuf+3; int dl=cmdlen-3; if(dl<8) return; int dst=rd16(d), src=rd16(d+3), n=rd16(d+6); if(dst+n>0x4000||src+n>0x4000) return; memcpy(g_rom+dst,g_rom+src,n); /* ueberlappungssicher genuegt hier memmove-Verhalten nicht noetig */ }
+
+static void dispatch(void){
+  u16 cmd=cmdbuf[1]|(cmdbuf[2]<<8);
+  switch(cmd){
+    case C_OPEN: h_open(); break;
+    case C_READ: case C_READ2: h_read(cmd); break;
+    case C_WRITE: h_write(); break;
+    case C_CLOSE: h_close(); break;
+    case C_SEEK: h_seek(); break;
+    case C_READDIR: h_readdir(); break;
+    case C_EOF: h_eof(); break;
+    case C_CD: h_cd(); break;
+    case C_FREE: h_free(); break;
+    case C_FTELL: case C_FSIZE: h_ftell(cmd); break;
+    case C_ERASEFILE: h_erase(); break;
+    case C_RENAME: h_rename(); break;
+    case C_MAKEDIR: h_mkdir(); break;
+    case C_GETPATH: h_getpath(); break;
+    case C_SDREAD: case C_SDWRITE: resp1(cmd,3); break;
+    case C_FSTAT: h_fstat(); break;
+    case C_HTTPGET: h_httpget(); break;
+    case C_SETNETWORK: resp1(cmd,0); break;
+    case C_M4OFF: case C_NMI: case C_ROMLOW: case C_ROMSUPDATE: case C_WIFIPOW: resp1(cmd,0); break;
+    case C_NETSTAT: h_netstat(); break;
+    case C_TIME: h_time(); break;
+    case C_DIRSETARGS: h_dirsetargs(); break;
+    case C_VERSION: { static const char v[]="M4 emulation for WinApe v1.0\0ESP emulated"; respond(C_VERSION,(const u8*)v,sizeof(v)); } break;
+    case C_UPGRADE: resps(cmd,"No upgrade available (emulated)"); break;
+    case C_HTTPGETMEM: h_httpgetmem(); break;
+    case C_COPYBUF: h_copybuf(); break;
+    case C_COPYFILE: h_copyfile(); break;
+    case C_NETSOCKET: h_netsocket(); break;
+    case C_NETCONNECT: h_netconnect(); break;
+    case C_NETCLOSE: h_netclose(); break;
+    case C_NETSEND: h_netsend(); break;
+    case C_NETRECV: h_netrecv(); break;
+    case C_NETHOSTIP: h_nethostip(); break;
+    case C_NETRSSI: resp1(cmd,20); break;
+    case C_NETBIND: h_netbind(); break;
+    case C_NETLISTEN: h_netlisten(); break;
+    case C_NETACCEPT: h_netaccept(); break;
+    case C_GETNETWORK: h_getnetwork(); break;
+    case C_ROMCP: h_romcp(); break;
+    case C_ROMWRITE: h_romwrite(); break;
+    case C_CONFIG: h_config(); break;
+    default: logx("UNBEKANNT",cmd); { u8 z[1]={0}; respond(cmd,z,1); } break;
+  }
+}
+
+void m4_port_write(u32 hi,u32 data){
+  if(hi==0xFE){ if(cmdlen<CMDMAX) cmdbuf[cmdlen++]=(u8)data; return; }
+  if(hi!=0xFC) return;
+  P_init();
+  if(!m4_enabled){ cmdlen=0; return; } /* M4 per Kontrollkaestchen abgeschaltet: Karte "nicht gesteckt" */
+  u8*rom=P_rom_base();               /* ACK: gesammelten Befehl verarbeiten */
+  if(!rom||cmdlen<3){ cmdlen=0; return; }
+  start_once();
+  LOCK(); g_rom=rom;
+  logx("CMD",(cmdbuf[2]<<8)|cmdbuf[1]);
+  dispatch();
+  UNLOCK();
+  cmdlen=0;
+}
diff --git a/src/m4/m4plat.h b/src/m4/m4plat.h
new file mode 100644
index 0000000..86249b3
--- /dev/null
+++ b/src/m4/m4plat.h
@@ -0,0 +1,50 @@
+/* M4 auf WinApe - Plattformschnittstelle (Datei, Netz, ROM-Zugriff) */
+#ifndef M4PLAT_H
+#define M4PLAT_H
+typedef unsigned char u8; typedef unsigned short u16; typedef unsigned int u32;
+#define FA_READ 0x01
+#define FA_WRITE 0x02
+#define FA_CREATE_NEW 0x04
+#define FA_CREATE_ALWAYS 0x08
+#define FA_OPEN_ALWAYS 0x10
+typedef struct { char name[260]; u32 size; u16 date, time; u8 attr; } P_ent; /* attr 0x10 = Verzeichnis */
+typedef struct { u16 year; u8 mon, day, hour, min, sec; } P_tm;
+/* Dateien: Pfade sind relativ zum SD-Wurzelordner, getrennt durch '/' */
+void *P_open(const char *path, int fa);
+int  P_read(void *h, u8 *buf, int n);
+int  P_write(void *h, const u8 *buf, int n);
+int  P_seek(void *h, u32 off);
+u32  P_tell(void *h);
+u32  P_size(void *h);
+void P_close(void *h);
+int  P_delete(const char *path);
+int  P_rename(const char *to, const char *from);
+int  P_mkdir(const char *path);
+int  P_rmdir(const char *path);
+int  P_copy(const char *src, const char *dst);
+void *P_findfirst(const char *dir, P_ent *e);  /* NULL = leer/Fehler */
+int  P_findnext(void *h, P_ent *e);            /* 1 = Eintrag */
+void P_findclose(void *h);
+int  P_stat(const char *path, P_ent *e);       /* 0 = ok */
+u32  P_freekb(void);
+void P_time(P_tm *t);
+/* Netzwerk (nicht blockierend) */
+int  P_sock_new(void);
+int  P_sock_connect(int s, const u8 ip[4], u16 port);
+int  P_sock_cstate(int s);                     /* 1 verbunden, 0 offen, -1 Fehler */
+int  P_sock_send(int s, const u8 *b, int n);   /* >=0 gesendet, -1 Fehler */
+int  P_sock_recv(int s, u8 *b, int n);         /* >0 Daten, 0 nichts, -1 geschlossen/Fehler */
+void P_sock_close(int s);
+int  P_sock_listen(int s, const u8 ip[4], u16 port);
+int  P_sock_accept(int s, u8 ip[4], u16 *port);/* neuer Socket oder -1 */
+int  P_resolve(const char *host, u8 ip[4]);    /* blockierend, 0 = ok */
+/* Sonstiges */
+u8  *P_rom_base(void);                         /* Zeiger auf 16KB M4-ROM-Abbild oder NULL */
+void P_start_worker(void (*fn)(void));
+void P_sleep(int ms);
+void P_log(const char *s);
+void P_init(void);                             /* Einstellungen (M4.INI) laden */
+extern int m4_enabled;                         /* 1 = M4 aktiv (Kontrollkaestchen in den WinAPE-Einstellungen) */
+/* Kern */
+void m4_port_write(u32 porthi, u32 data);
+#endif
diff --git a/src/m4/m4plat_host.c b/src/m4/m4plat_host.c
new file mode 100644
index 0000000..781974f
--- /dev/null
+++ b/src/m4/m4plat_host.c
@@ -0,0 +1,123 @@
+/* M4 board emulation - host platform layer for Caprice32 (Linux/macOS: POSIX, Windows: Win32 + Winsock) */
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <io.h>
+#include <direct.h>
+#include <fcntl.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <errno.h>
+#include "m4plat.h"
+#else
+#define _GNU_SOURCE
+#include "m4plat.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <sys/socket.h>
+#include <sys/select.h>
+#include <netinet/in.h>
+#include <netdb.h>
+#include <arpa/inet.h>
+#include <pthread.h>
+#include <time.h>
+#include <sched.h>
+#endif
+
+#ifndef O_BINARY
+#define O_BINARY 0
+#endif
+#ifdef _WIN32
+#define MKDIR(p) _mkdir(p)
+#define SOCK_ERR() WSAGetLastError()
+#define E_INPROGRESS WSAEWOULDBLOCK
+#define E_AGAIN WSAEWOULDBLOCK
+#define CLOSESOCK(s) closesocket(s)
+#define SENDFLAGS 0
+typedef char sockopt_t;
+static void net_up(void){ static int up; if(!up){ WSADATA w; WSAStartup(MAKEWORD(2,2),&w); up=1; } }
+static void set_nonblock(int s){ u_long on=1; ioctlsocket((SOCKET)s,FIONBIO,&on); }
+#else
+#define MKDIR(p) mkdir(p,0755)
+#define SOCK_ERR() errno
+#define E_INPROGRESS EINPROGRESS
+#define E_AGAIN EAGAIN
+#define CLOSESOCK(s) close(s)
+#ifdef MSG_NOSIGNAL
+#define SENDFLAGS MSG_NOSIGNAL
+#else
+#define SENDFLAGS 0
+#endif
+typedef int sockopt_t;
+static void net_up(void){}
+static void set_nonblock(int s){ fcntl(s,F_SETFL,O_NONBLOCK); }
+#endif
+
+char P_root[512]="m4sd"; static u8 *P_rom; static int P_logon;
+void m4_set_rom(u8 *rom){ P_rom=rom; }
+void m4_set_root(const char *root){ snprintf(P_root,sizeof P_root,"%s",root); size_t n=strlen(P_root); while(n>1&&(P_root[n-1]=='/'||P_root[n-1]=='\\')) P_root[--n]=0; MKDIR(P_root); }
+void m4_set_log(int on){ P_logon=on; }
+static void full(const char*p,char*o){ snprintf(o,1024,"%s/%s",P_root,p); }
+void *P_open(const char*path,int fa){ char f[1024]; full(path,f); int fl=0;
+  if((fa&3)==3||(fa&2)) fl=(fa&1)?O_RDWR:O_WRONLY; else fl=O_RDONLY;
+  if(fa&FA_CREATE_NEW) fl|=O_CREAT|O_EXCL; if(fa&FA_CREATE_ALWAYS) fl|=O_CREAT|O_TRUNC; if(fa&FA_OPEN_ALWAYS) fl|=O_CREAT;
+  int fd=open(f,fl|O_BINARY,0644); if(fd<0) return NULL; return (void*)(long)(fd+1); }
+#define FD(h) ((int)(long)(h)-1)
+int P_read(void*h,u8*b,int n){ return read(FD(h),b,n); }
+int P_write(void*h,const u8*b,int n){ return write(FD(h),b,n); }
+int P_seek(void*h,u32 o){ return lseek(FD(h),o,SEEK_SET)<0?-1:0; }
+u32 P_tell(void*h){ return lseek(FD(h),0,SEEK_CUR); }
+u32 P_size(void*h){ struct stat s; fstat(FD(h),&s); return s.st_size; }
+void P_close(void*h){ close(FD(h)); }
+int P_delete(const char*p){ char f[1024]; full(p,f); return unlink(f); }
+int P_rename(const char*t,const char*f){ char a[1024],b[1024]; full(t,a); full(f,b);
+#ifdef _WIN32
+  return MoveFileExA(b,a,MOVEFILE_REPLACE_EXISTING)?0:-1;
+#else
+  return rename(b,a);
+#endif
+}
+int P_mkdir(const char*p){ char f[1024]; full(p,f); return MKDIR(f); }
+int P_rmdir(const char*p){ char f[1024]; full(p,f); return rmdir(f); }
+int P_copy(const char*s,const char*d){ void*a=P_open(s,FA_READ); if(!a) return -1; void*b=P_open(d,FA_WRITE|FA_CREATE_ALWAYS); if(!b){P_close(a);return -1;} u8 buf[4096]; int n; while((n=P_read(a,buf,4096))>0) P_write(b,buf,n); P_close(a); P_close(b); return 0; }
+static void fill(const char*dir,const char*name,P_ent*e){ char f[1024],g[1024]; snprintf(g,1024,"%s/%s",dir,name); full(g,f); struct stat s; memset(e,0,sizeof*e); snprintf(e->name,260,"%s",name); if(stat(f,&s)==0){ e->size=s.st_size; e->attr=S_ISDIR(s.st_mode)?0x10:0x20; } }
+typedef struct { DIR*d; char dir[512]; } FH;
+void *P_findfirst(const char*dir,P_ent*e){ char f[1024]; full(dir,f); DIR*d=opendir(f); if(!d) return NULL; FH*h=malloc(sizeof*h); h->d=d; snprintf(h->dir,512,"%s",dir); if(!P_findnext(h,e)){ closedir(d); free(h); return NULL; } return h; }
+int P_findnext(void*hh,P_ent*e){ FH*h=hh; struct dirent*de; while((de=readdir(h->d))){ if(!strcmp(de->d_name,".")||!strcmp(de->d_name,"..")) continue; fill(h->dir,de->d_name,e); return 1; } return 0; }
+void P_findclose(void*hh){ FH*h=hh; closedir(h->d); free(h); }
+int P_stat(const char*p,P_ent*e){ char f[1024]; full(p,f); struct stat s; if(stat(f,&s)) return -1; memset(e,0,sizeof*e); const char*b=strrchr(p,'/'); snprintf(e->name,260,"%s",b?b+1:p); e->size=s.st_size; e->attr=S_ISDIR(s.st_mode)?0x10:0x20; return 0; }
+u32 P_freekb(void){ return 123456; }
+void P_time(P_tm*t){ time_t n=time(0); struct tm*l=localtime(&n); t->year=l->tm_year+1900; t->mon=l->tm_mon+1; t->day=l->tm_mday; t->hour=l->tm_hour; t->min=l->tm_min; t->sec=l->tm_sec; }
+int P_sock_new(void){ net_up(); int s=(int)socket(AF_INET,SOCK_STREAM,0); if(s>=0) set_nonblock(s); return s; }
+int P_sock_connect(int s,const u8 ip[4],u16 port){ struct sockaddr_in a; memset(&a,0,sizeof a); a.sin_family=AF_INET; memcpy(&a.sin_addr,ip,4); a.sin_port=htons(port); int r=connect(s,(void*)&a,sizeof a); if(r<0&&SOCK_ERR()!=E_INPROGRESS) return -1; return 0; }
+int P_sock_cstate(int s){ fd_set w,x; FD_ZERO(&w); FD_ZERO(&x); FD_SET(s,&w); FD_SET(s,&x); struct timeval tv={0,0}; if(select(s+1,0,&w,&x,&tv)<=0) return 0; if(FD_ISSET(s,&x)) return -1; int e=0; socklen_t l=sizeof e; getsockopt(s,SOL_SOCKET,SO_ERROR,(sockopt_t*)&e,&l); return e?-1:1; }
+int P_sock_send(int s,const u8*b,int n){ int r=(int)send(s,(const char*)b,n,SENDFLAGS); if(r<0) return (SOCK_ERR()==E_AGAIN)?0:-1; return r; }
+int P_sock_recv(int s,u8*b,int n){ int r=(int)recv(s,(char*)b,n,0); if(r>0) return r; if(r==0) return -1; return (SOCK_ERR()==E_AGAIN)?0:-1; }
+void P_sock_close(int s){ CLOSESOCK(s); }
+int P_sock_listen(int s,const u8 ip[4],u16 port){ struct sockaddr_in a; memset(&a,0,sizeof a); a.sin_family=AF_INET; memcpy(&a.sin_addr,ip,4); a.sin_port=htons(port); int o=1; setsockopt(s,SOL_SOCKET,SO_REUSEADDR,(const sockopt_t*)&o,sizeof o); if(bind(s,(void*)&a,sizeof a)) return -1; return listen(s,2); }
+int P_sock_accept(int s,u8 ip[4],u16*port){ struct sockaddr_in a; socklen_t l=sizeof a; int n=(int)accept(s,(void*)&a,&l); if(n<0) return -1; set_nonblock(n); memcpy(ip,&a.sin_addr,4); *port=ntohs(a.sin_port); return n; }
+int P_resolve(const char*h,u8 ip[4]){ net_up(); struct addrinfo hi,*r; memset(&hi,0,sizeof hi); hi.ai_family=AF_INET; if(getaddrinfo(h,0,&hi,&r)) return -1; memcpy(ip,&((struct sockaddr_in*)r->ai_addr)->sin_addr,4); freeaddrinfo(r); return 0; }
+u8 *P_rom_base(void){ return P_rom; }
+#ifdef _WIN32
+static DWORD WINAPI thr(LPVOID f){ ((void(*)(void))f)(); return 0; }
+void P_start_worker(void(*fn)(void)){ HANDLE h=CreateThread(NULL,0,thr,(LPVOID)fn,0,NULL); if(h) CloseHandle(h); }
+void P_sleep(int ms){ Sleep(ms<0?0:ms); }
+#else
+static void*thr(void*f){ ((void(*)(void))f)(); return 0; }
+void P_start_worker(void(*fn)(void)){ pthread_t t; pthread_create(&t,0,thr,(void*)fn); pthread_detach(t); }
+void P_sleep(int ms){ if(ms<=0){ sched_yield(); return; } usleep(ms*1000); }
+#endif
+void P_log(const char*s){ if(P_logon) fputs(s,stderr); }
+
+void P_init(void){}
diff --git a/src/pe/include/pe/driver.h b/src/pe/include/pe/driver.h
new file mode 100644
index 0000000..c3c32d6
--- /dev/null
+++ b/src/pe/include/pe/driver.h
@@ -0,0 +1,59 @@
+/*
+ * Pluggable printer emulations.
+ *
+ * A driver is a byte pump: it receives the data stream and calls into the
+ * engine to put dots on the page.  Adding a printer means writing one of
+ * these and registering it in registry.c - nothing else in the core changes.
+ */
+#ifndef PE_DRIVER_H
+#define PE_DRIVER_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "pe/pe.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A typeface the printer offers through ESC k, as listed on the test page. */
+typedef struct {
+  uint8_t id;              /* ESC k parameter                          */
+  uint8_t proportional;    /* has proportional artwork                 */
+  const char *name;
+} pe_typeface;
+
+typedef struct pe_driver {
+  const char *id;          /* short name used on the command line/API  */
+  const char *name;        /* human readable                           */
+  const char *description;
+  size_t state_size;       /* per job state the core allocates         */
+  int32_t dot_diameter;    /* default print wire dot size, in units    */
+  const pe_typeface *typefaces; /* ends with a NULL name; may be NULL  */
+  void (*init)(void *state, pe_engine *e);
+  void (*reset)(void *state, pe_engine *e);   /* ESC @ / hardware INIT */
+  void (*byte)(void *state, pe_engine *e, uint8_t b);
+  void (*eoj)(void *state, pe_engine *e);     /* end of job            */
+  int32_t fanfold_dy;      /* fanfold paper: print this much lower than the line
+                              grid (units, 85 = 1 mm); 0 = none            */
+} pe_driver;
+
+/* Built in drivers. */
+extern const pe_driver pe_driver_fx80;
+extern const pe_driver pe_driver_p6;
+extern const pe_driver pe_driver_eplq;
+extern const pe_driver pe_driver_lq800;
+extern const pe_driver pe_driver_kxp;
+extern const pe_driver pe_driver_lc24;
+extern const pe_driver pe_driver_nlq401;
+extern const pe_driver pe_driver_nlq401d;
+
