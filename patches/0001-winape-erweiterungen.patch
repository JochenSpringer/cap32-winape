+void CapriceSettings::UpdateRamTotal()
+{
+  int kb = static_cast<int>(CPC.ram_size);
+  if (Checked(m_ram64)) {
+    kb = 64;
+  } else if (Checked(m_ram128)) {
+    kb = 128;
+  } else if (Checked(m_ram320)) {
+    kb = 320;
+  } else if (Checked(m_ram576)) {
+    kb = 576;
+  }
+  m_pRamTotal->SetWindowText(stdex::itoa(kb) + "K");
