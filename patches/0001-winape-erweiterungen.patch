+  }
+  if(!wr){ /* Lesen: Name, dann (nur AMSDOS-Modus) .BAS und .BIN probieren */
+    char c[3][270]; int nc=1; cpystr(c[0],file,270); int blank=0; int n=(int)strlen(c[0]); if(n&&c[0][n-1]=='.'){ c[0][n-1]=0; blank=1; }
+    if(!real&&!blank&&lastdot(c[0])<0&&!haswild(c[0])){ cpystr(c[1],c[0],270); cpystr(c[1]+n,".BAS",8); cpystr(c[2],c[0],270); cpystr(c[2]+n,".BIN",8); nc=3; }
+    for(i=0;i<nc;i++){ char real_n[260]; int isd; if(find_host(dir,c[i],real_n,&isd,NULL)&&!isd){ char p[512]; joinp(p,dir,real_n); void*h=P_open(p,FA_READ); if(h){ f->kind=1; f->h=h; out[0]=fd; out[1]=0; break; } } }
