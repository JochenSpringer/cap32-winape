+static void h_read(u16 cmd){
+  u8*d=cmdbuf+3; FD*f=getfd(d[0]); int n=rd16(d+1); static u8 tmp[0x810];
+  if(n>0x800) n=0x800;
+  if(cmd==C_READ2){ /* [3]=Status (20 = Dateiende), [4..5]=Anzahl, [8..]=Daten */
+    memset(tmp,0,8);
+    if(!f){ tmp[0]=20; respond(cmd,tmp,5); return; }
+    int got=fd_read(f,tmp+5,n); if(got<0) got=0; tmp[0]=(got<n)?20:0; wr16(tmp+1,got); respond(cmd,tmp,5+got); return; }
+  /* C_READ: [3]=Status, danach genau n Datenbytes (Rest mit 0 aufgefuellt) */
+  if(!f){ tmp[0]=0xFF; respond(cmd,tmp,1); return; }
+  memset(tmp,0,n+1); int got=fd_read(f,tmp+1,n); (void)got; tmp[0]=0; respond(cmd,tmp,n+1);
+}
+static void h_write(void){
+  u8*d=cmdbuf+3; FD*f=getfd(d[0]); u8 r=0xFF;
+  if(f&&(f->kind==1||f->kind==3)&&P_write(f->h,d+1,cmdlen-4)>=0) r=0;
+  resp1(C_WRITE,r);
+}
+static void h_close(void){
+  /* Wie die echte Firmware: Schliessen eines nicht geoeffneten Kanals meldet 0xFF. Das M4-ROM zaehlt diese beiden
+     Fehlschlaege beim Systemstart (CAS-Initialisierung) mit, gibt dann das Banner aus und aktiviert AUTOEXEC.BAS. */
+  int n=cmdbuf[3]&15; FD*f=&fds[n]; u8 r=0xFF;
+  if(f->kind){ r=0; if(f->kind==3) finish_write(f); else if(f->kind==1) P_close(f->h); f->kind=0; }
+  resp1(C_CLOSE,r);
