+static void h_netbind(void){ u8*d=cmdbuf+3; int s=d[0]; u8 r=0xFF; if(s>=1&&s<NSOCK&&socks[s].h>=0){ memcpy(socks[s].bip,d+1,4); socks[s].bport=rd16(d+5); r=0; } resp1(C_NETBIND,r); }
+static void h_netlisten(void){ int s=cmdbuf[3]; u8 r=0xFF; if(s>=1&&s<NSOCK&&socks[s].h>=0&&P_sock_listen(socks[s].h,socks[s].bip,socks[s].bport)==0){ socks[s].listening=1; r=0; } resp1(C_NETLISTEN,r); }
+static void h_netaccept(void){ int s=cmdbuf[3]; u8 r=0xFF; if(s>=1&&s<NSOCK&&socks[s].listening){ si_status(s,4,4); r=0; } resp1(C_NETACCEPT,r); }
