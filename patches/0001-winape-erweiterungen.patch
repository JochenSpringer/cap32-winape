diff --git a/src/gui/src/CapriceSettings.cpp b/src/gui/src/CapriceSettings.cpp
new file mode 100644
index 0000000..899f108
--- /dev/null
+++ b/src/gui/src/CapriceSettings.cpp
@@ -0,0 +1,811 @@
+// 'Settings' window for Caprice32: the pages and settings of the WinAPE setup dialog.
+// See CapriceSettings.h.
+
+#include <algorithm>
+#include <filesystem>
+#include <string>
+#include <vector>
+#include "CapriceSettings.h"
+#include "CapriceSettingsKeys.h"
+#include "CapriceRomSlots.h"
+#include "log.h"
+#include "std_ex.h"
+#include "cap32.h"
+#include "net4cpc.h"
+#include "keyboard.h"
+#include "fileutils.h"
+#include "printer_pdf.h"
+#include "video.h"
+#include "wg_messagebox.h"
+
+// CPC emulation properties, defined in cap32.h:
+extern t_CPC CPC;
+
+namespace wGui {
+
+namespace {
+
+// WinAPE (Delphi) child coordinates inside a group box are relative to the top of the box, wGui's are
+// relative to the area below the caption. This is the height of the caption.
+constexpr int GY = 13;
+
+constexpr int PAGE_X = 5;
+constexpr int PAGE_Y = 32;
+constexpr int PAGE_W = SETTINGS_WIDTH - 10;
+constexpr int PAGE_H = 318;
+
+const char* const kPageNames[] = { "General", "Display", "Sound", "Memory", "Input", "Other" };
+
+} // namespace
+
+// ============================================================================================
+// Helpers to create controls
+// ============================================================================================
+
+void CapriceSettings::Gray(CWindow* window, const std::string& what)
+{
+  window->SetEnabled(false);
+  std::string entry = m_sPageName;
+  if (!m_sGroupName.empty()) {
+    entry += " / " + m_sGroupName;
+  }
+  m_unavailable.push_back(entry + ": " + what);
+}
+
+CapriceSettings::CheckItem CapriceSettings::AddCheck(CWindow* parent, int x, int y, const std::string& text, bool value, bool available)
+{
+  CheckItem item;
+  item.box = new CCheckBox(CRect(CPoint(x, y), 10, 10), parent);
+  item.label = new CLabel(CPoint(x + 16, y + 1), parent, text);
+  item.available = available;
+  if (value) {
+    item.box->SetCheckBoxState(CCheckBox::CHECKED);
+  }
+  if (available) {
+    item.box->SetIsFocusable(true);
+  } else {
+    item.box->SetEnabled(false);
+    item.label->SetEnabled(false);
+    m_unavailable.push_back(m_sPageName + (m_sGroupName.empty() ? "" : " / " + m_sGroupName) + ": " + text);
+  }
+  return item;
+}
+
+CapriceSettings::RadioItem CapriceSettings::AddRadio(CWindow* parent, int x, int y, const std::string& text, bool value, bool available)
+{
+  RadioItem item;
+  item.radio = new CRadioButton(CPoint(x, y), 10, parent);
+  item.label = new CLabel(CPoint(x + 16, y + 1), parent, text);
+  item.available = available;
+  if (value) {
+    item.radio->SetState(CRadioButton::CHECKED);
+  }
+  if (available) {
+    item.radio->SetIsFocusable(true);
+  } else {
+    item.radio->SetEnabled(false);
+    item.label->SetEnabled(false);
+    m_unavailable.push_back(m_sPageName + (m_sGroupName.empty() ? "" : " / " + m_sGroupName) + ": " + text);
+  }
+  return item;
+}
+
+CLabel* CapriceSettings::AddLabel(CWindow* parent, int x, int y, const std::string& text, bool available)
+{
+  CLabel* label = new CLabel(CPoint(x, y), parent, text);
+  if (!available) {
+    label->SetEnabled(false);
+  }
+  return label;
+}
+
+CDropDown* CapriceSettings::AddDropDown(CWindow* parent, int x, int y, int w, const std::vector<std::string>& items, int selected, bool available)
+{
+  CDropDown* dd = new CDropDown(CRect(CPoint(x, y), w, 16), parent, false);
+  for (const auto& item : items) {
+    dd->AddItem(SListItem(item));
+  }
+  dd->SetListboxHeight(std::min<int>(static_cast<int>(items.size()), 8));
+  if (selected >= 0 && selected < static_cast<int>(items.size())) {
+    dd->SelectItem(static_cast<unsigned int>(selected));
+  }
+  if (available) {
+    dd->SetIsFocusable(true);
+  } else {
+    dd->SetEnabled(false);
+  }
+  return dd;
+}
+
+CScrollBar* CapriceSettings::AddSlider(CWindow* parent, int x, int y, int w, int min, int max, int step, int value, bool available)
+{
+  CScrollBar* bar = new CScrollBar(CRect(CPoint(x, y), w, 12), parent, CScrollBar::HORIZONTAL);
+  bar->SetMinLimit(min);
+  bar->SetMaxLimit(max);
+  bar->SetStepSize(step);
+  bar->SetValue(value, true, false);
+  if (available) {
+    bar->SetIsFocusable(true);
+  } else {
+    bar->SetEnabled(false);
+  }
+  return bar;
+}
+
+CEditBox* CapriceSettings::AddEdit(CWindow* parent, int x, int y, int w, const std::string& text, bool available, bool readOnly)
+{
+  CEditBox* edit = new CEditBox(CRect(CPoint(x, y), w, 16), parent);
+  edit->SetWindowText(text);
+  edit->SetReadOnly(readOnly);
+  if (available) {
+    edit->SetIsFocusable(true);
+  } else {
+    edit->SetEnabled(false);
+  }
+  return edit;
+}
+
+CButton* CapriceSettings::AddButton(CWindow* parent, int x, int y, int w, int h, const std::string& text, bool available)
+{
+  CButton* button = new CButton(CRect(CPoint(x, y), w, h), parent, text);
+  if (available) {
+    button->SetIsFocusable(true);
+  } else {
+    button->SetEnabled(false);
+  }
+  return button;
+}
+
+CButton* CapriceSettings::AddBrowse(CWindow* parent, int x, int y, CEditBox* edit, const std::string& kind, const std::string& title,
+                                    const std::string& filterName, const std::string& patterns, FileDialogMode mode, const std::string& defaultDir)
+{
+  CButton* button = AddButton(parent, x, y, 17, 16, "...");
+  m_browse.push_back({ button, edit, kind, title, filterName, patterns, mode, defaultDir });
+  return button;
+}
+
+bool CapriceSettings::HandleBrowse(const CMessageClient* source)
+{
+  for (auto& b : m_browse) {
+    if (source != b.button) continue;
+    bool available = true;
+    std::string start = b.defaultDir;
+    std::string current = b.edit->GetWindowText();
+    if (b.mode == FileDialogMode::FOLDER && !current.empty()) start = current;
+    std::string result = filedialog_pick(b.kind, b.title, b.filterName, b.patterns, available, start, b.mode);
+    if (!available) {
+      CMessageBox* box = new CMessageBox(CRect(CPoint(SETTINGS_WIDTH / 2 - 160, 150), 320, 70), this, nullptr, "File dialog",
+                                         "No file dialog found (install zenity). Type the path instead.", CMessageBox::BUTTON_OK);
+      box->SetModal(true);
+    } else if (!result.empty()) {
+      b.edit->SetWindowText(result);
+    }
+    return true;
+  }
+  return false;
+}
+
+CGroupBox* CapriceSettings::AddGroup(CWindow* parent, int x, int y, int w, int h, const std::string& caption)
+{
+  m_sGroupName = caption;
+  return new CGroupBox(CRect(CPoint(x, y), w, h), parent, caption);
+}
