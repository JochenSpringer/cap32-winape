+// ============================================================================================
+// The window
+// ============================================================================================
+
+CapriceSettings::CapriceSettings(const CRect& WindowRect, CWindow* pParent, CFontEngine* pFontEngine) :
+  CFrame(WindowRect, pParent, pFontEngine, "Caprice32 - Settings", false)
+{
+  SetModal(true);
+  Application().MessageServer()->RegisterMessageClient(this, CMessage::CTRL_VALUECHANGE);
+  Application().MessageServer()->RegisterMessageClient(this, CMessage::CTRL_VALUECHANGING);
+  Application().MessageServer()->RegisterMessageClient(this, CMessage::KEYBOARD_KEYDOWN);
+
+  // Pages
+  m_pNavigationBar = new CNavigationBar(this, CPoint(PAGE_X, 6), 6, 100, 22);
+  for (const char* name : kPageNames) {
+    m_pNavigationBar->AddItem(SNavBarItem(name));
+  }
+  m_pNavigationBar->SetIsFocusable(true);
+  for (size_t i = 0; i < 6; ++i) {
+    m_pages.push_back(new CGroupBox(CRect(CPoint(PAGE_X, PAGE_Y), PAGE_W, PAGE_H), this, ""));
+  }
+  m_sGroupName = "";
+  m_sPageName = kPageNames[0]; BuildGeneral(m_pages[0]);
+  m_sGroupName = ""; m_sPageName = kPageNames[1]; BuildDisplay(m_pages[1]);
+  m_sGroupName = ""; m_sPageName = kPageNames[2]; BuildSound(m_pages[2]);
+  m_sGroupName = ""; m_sPageName = kPageNames[3]; BuildMemory(m_pages[3]);
+  m_sGroupName = ""; m_sPageName = kPageNames[4]; BuildInput(m_pages[4]);
+  m_sGroupName = ""; m_sPageName = kPageNames[5]; BuildOther(m_pages[5]);
+  SelectPage(0);
+
+  const int by = PAGE_Y + PAGE_H + 8;
+  m_pButtonHelp   = AddButton(this, PAGE_X, by, 60, 16, "Help");
+  m_pButtonSave   = AddButton(this, SETTINGS_WIDTH - 5 - 3 * 70 - 10, by, 60, 16, "Save");
+  m_pButtonCancel = AddButton(this, SETTINGS_WIDTH - 5 - 2 * 70 - 5, by, 60, 16, "Cancel");
+  m_pButtonOk     = AddButton(this, SETTINGS_WIDTH - 5 - 70, by, 60, 16, "OK");
+}
