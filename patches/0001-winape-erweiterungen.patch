+  if(*p==':'){ p++; port=0; while(*p>='0'&&*p<='9') port=port*10+(*p++-'0'); }
+  path[0]='/'; i=1; if(*p=='/'){ p++; } while(*p&&*p!=','&&i<390) path[i++]=*p++; path[i]=0;
+  u8 ip[4]; if(P_resolve(host,ip)!=0) return -1;
+  int s=P_sock_new(); if(s<0) return -2;
+  if(P_sock_connect(s,ip,port)!=0){ P_sock_close(s); return -3; }
+  int t=0; while(P_sock_cstate(s)==0 && t<5000){ P_sleep(5); t+=5; }
+  if(P_sock_cstate(s)!=1){ P_sock_close(s); return -3; }
+  char req[900]; int n=0; const char*a="GET ";
+  #define ADD(x) do{ const char*q=(x); while(*q&&n<880) req[n++]=*q++; }while(0)
+  ADD(a); ADD(path); ADD(" HTTP/1.0\r\nHost: "); ADD(host); ADD("\r\nUser-Agent: M4-WinAPE\r\nConnection: close\r\n\r\n");
+  int off=0; while(off<n){ int w=P_sock_send(s,(u8*)req+off,n-off); if(w<0){ P_sock_close(s); return -4;} if(w==0){P_sleep(2);} off+=w; }
+  static u8 rb[2048]; int hdr=1; char hb[512]; int hl=0; u32 skipped=0; int idle=0; *status=0; int stop=0;
+  while(!stop){
+    int r=P_sock_recv(s,rb,sizeof rb);
+    if(r<0) break;
+    if(r==0){ P_sleep(5); if(++idle>3000){ break; } continue; }
+    idle=0; int pos=0;
+    if(hdr){
+      while(pos<r){ if(hl<511) hb[hl++]=rb[pos]; pos++;
+        if(hl>=4&&hb[hl-4]=='\r'&&hb[hl-3]=='\n'&&hb[hl-2]=='\r'&&hb[hl-1]=='\n'){ hdr=0; break; } }
+      if(!hdr){ hb[hl]=0; if(hb[0]=='H'){ int c=0; const char*q=hb; while(*q&&*q!=' ') q++; while(*q==' ') q++; while(*q>='0'&&*q<='9') c=c*10+(*q++-'0'); *status=c; } }
+      else continue;
+    }
+    if(*status!=200 && *status!=206){ stop=1; break; }
+    if(skipped<offset){ u32 sk=offset-skipped; if(sk>(u32)(r-pos)) sk=r-pos; skipped+=sk; pos+=sk; }
+    if(pos<r){ if(cb(rb+pos,r-pos,ctx)) stop=1; }
+  }
+  P_sock_close(s); return 0;
+}
+typedef struct { u8*buf; int cap; int len; void*fh; u32 total; } Sink;
+static int sink_mem(const u8*b,int n,void*c){ Sink*s=(Sink*)c; int room=s->cap-s->len; if(n>room) n=room; memcpy(s->buf+s->len,b,n); s->len+=n; return s->len>=s->cap; }
+static int sink_file(const u8*b,int n,void*c){ Sink*s=(Sink*)c; P_write(s->fh,b,n); s->total+=n; return 0; }
+static void h_httpgetmem(void){
+  u8*d=cmdbuf+3; int size=rd16(d); char spec[400]; int i; for(i=0;i<cmdlen-5&&i<399&&d[2+i];i++) spec[i]=d[2+i]; spec[i]=0;
