+    if(sz>=128){ u32 sum=0; for(int k=0;k<66;k++) sum+=m[k]; if((sum&0xFFFF)==(u32)(m[67]|(m[68]<<8))){ u32 len=m[64]|(m[65]<<8)|(m[66]<<16); if(!len) len=m[24]|(m[25]<<8); if(128+len<sz) sz=128+len; } }
