+/* ----- Zugriffsfunktionen ----- */
+static int fd_read(FD*f,u8*b,int n){ if(f->kind==2){ u32 r=f->size-f->pos; if((u32)n>r) n=(int)r; memcpy(b,f->mem+f->pos,n); f->pos+=n; return n; } return P_read(f->h,b,n); }
+static int fd_seek(FD*f,u32 o){ if(f->kind==2){ f->pos=o>f->size?f->size:o; return 0; } return P_seek(f->h,o); }
+static u32 fd_tell(FD*f){ return f->kind==2?f->pos:P_tell(f->h); }
+static u32 fd_size(FD*f){ return f->kind==2?f->size:P_size(f->h); }
+static FD *getfd(int n){ n&=15; return fds[n].kind?&fds[n]:NULL; }
