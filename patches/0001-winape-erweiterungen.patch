+CapriceSettingsView::CapriceSettingsView(CApplication& application, SDL_Surface* surface, SDL_Renderer* renderer, SDL_Texture* texture, const CRect& WindowRect) :
+  CView(application, surface, nullptr, WindowRect), m_pRenderer(renderer), m_pTexture(texture)
+{
+  Application().MessageServer()->RegisterMessageClient(this, CMessage::CTRL_MESSAGEBOXRETURN);
+  m_pFrame = new CapriceSettings(CRect(CPoint(0, 0), SETTINGS_WIDTH, SETTINGS_HEIGHT), this, nullptr);
+}
+
+void CapriceSettingsView::PaintToSurface(SDL_Surface& ScreenSurface, SDL_Surface& FloatingSurface, const CPoint& Offset) const
+{
+  if (m_bVisible) {
+    SDL_FillRect(&ScreenSurface, nullptr, SDL_MapRGB(ScreenSurface.format, 255, 255, 255));
+    for (const auto child : m_ChildWindows) {
+      if (child) {
+        child->PaintToSurface(ScreenSurface, FloatingSurface, Offset);
+      }
+    }
+  }
+}
+
+void CapriceSettingsView::Flip() const
+{
+  SDL_UpdateTexture(m_pTexture, nullptr, m_pScreenSurface->pixels, m_pScreenSurface->pitch);
+  SDL_RenderClear(m_pRenderer);
+  SDL_RenderCopy(m_pRenderer, m_pTexture, nullptr, nullptr);
+  SDL_RenderPresent(m_pRenderer);
+}
+
+void CapriceSettingsView::Close()
+{
+  m_pFrame->CloseFrame();
+}
