+    u8*m=dskmem[bufi]; u32 pos=0, cap=sizeof dskmem[0]; int totrec=0;
+    for(int ex=0;ex<64;ex++) for(int j=0;j<64;j++){ const u8*e=dsk_dir+j*32; if(!dsk_valid(e)) continue; int same=1; for(int k=1;k<12;k++) if((e[k]&0x7F)!=(e0[k]&0x7F)) same=0;
+      if(!same) continue; if(((e[12]&0x1F)+(e[14]<<5))!=ex) continue;
+      int rc=e[15]; totrec+=rc; int nb=(rc+7)/8;
+      for(int b=0;b<nb&&b<16;b++){ int blk=e[16+b]; u8 sec[512];
+        for(int s=0;s<2;s++){ if(dsk_lsector(blk*2+s,sec)) return -1; u32 n=512; if(pos+n>cap) n=cap-pos; memcpy(m+pos,sec,n); pos+=n; } } }
