+}
+static u32 dsk_free_kb(void){
+  u8 used[256]; memset(used,0,256); int total=(dsk_nt-dsk_rt)*dsk_nsec/2; if(total>255) total=255;
+  for(int i=0;i<64;i++){ const u8*e=dsk_dir+i*32; if(e[0]==0xE5) continue; for(int b=0;b<16;b++) used[e[16+b]]=1; }
+  int u=0; for(int b=2;b<total;b++) if(used[b]) u++; return (u32)(total-2-u);
+}
