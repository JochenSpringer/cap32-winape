+
+#define CMDMAX 0x1000
+#define RBUF 0x4000
+static u8 cmdbuf[CMDMAX]; static int cmdlen;
+static u8 *g_rom; static volatile int g_lock; static int g_started;
+static char curdir[256];           /* relativ zur Wurzel, ohne fuehrenden/endenden '/' */
+static u8 membuf[RBUF]; static int memlen;
+static int logon = 1;
+int m4_enabled = 1;
+
+#define LOCK() do{ while(__sync_lock_test_and_set(&g_lock,1)) P_sleep(0); }while(0)
+#define UNLOCK() __sync_lock_release(&g_lock)
+
+static u16 rd16(const u8*p){return p[0]|(p[1]<<8);}
+static u32 rd32(const u8*p){return p[0]|(p[1]<<8)|(p[2]<<16)|((u32)p[3]<<24);}
+static void wr16(u8*p,u16 v){p[0]=v;p[1]=v>>8;}
+static void wr32(u8*p,u32 v){p[0]=v;p[1]=v>>8;p[2]=v>>16;p[3]=v>>24;}
+
+static void logx(const char*tag,u32 v){
+  if(!logon) return;
+  char b[48]; int n=0; const char*h="0123456789ABCDEF";
+  while(*tag&&n<30) b[n++]=*tag++;
+  b[n++]=' '; for(int i=28;i>=0;i-=4) b[n++]=h[(v>>i)&15]; b[n++]='\r'; b[n++]='\n'; b[n]=0;
+  P_log(b);
+}
+
+static void logs(const char*tag,const char*v){ char b[300]; int n=0; while(*tag&&n<20) b[n++]=*tag++; b[n++]=' '; b[n++]='"'; while(*v&&n<280) b[n++]=*v++; b[n++]='"'; b[n++]='\r'; b[n++]='\n'; b[n]=0; P_log(b); }
+/* ---------- Zugriff auf ROM-Speicher des M4 ---------- */
+static u8 *resp_buf(void){ return g_rom + (rd16(g_rom+0x3F02)-0xC000); }
+static u8 *sockinfo(void){ return g_rom + (rd16(g_rom+0x3F06)-0xC000); }
+static u8 *cfg_buf(void){ return g_rom + (rd16(g_rom+0x3F04)-0xC000); }
+
+static void respond(u16 cmd,const u8*d,int n){
+  u8 *r=resp_buf(); if(n>0x900) n=0x900;
+  r[0]=(n+2>255)?255:(n+2); r[1]=cmd&255; r[2]=cmd>>8;
+  if(n>0 && d) memcpy(r+3,d,n);
+}
+static void resp1(u16 cmd,u8 v){ respond(cmd,&v,1); }
+static void resps(u16 cmd,const char*s){ respond(cmd,(const u8*)s,(int)strlen(s)+1); }
