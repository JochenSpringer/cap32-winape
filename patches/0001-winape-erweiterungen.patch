+}
+static int dsk_lsector(int L,u8*buf){ return dsk_sector(dsk_rt+L/dsk_nsec,dsk_idb+L%dsk_nsec,buf); }
+static void dsk_unmount(void){ if(dskf){ P_close(dskf); dskf=NULL; } in_dsk=0; dskname[0]=0; }
+static int dsk_mount(const char*path){
+  void*h=P_open(path,FA_READ); if(!h) return -1; u8 hd[256];
+  if(P_read(h,hd,256)!=256){ P_close(h); return -1; }
+  int ext=!memcmp(hd,"EXTENDED",8); if(!ext&&memcmp(hd,"MV - CPC",8)){ P_close(h); return -1; }
+  int nt=hd[0x30], sd=hd[0x31]; if(nt<1||nt>84||sd<1||sd>2){ P_close(h); return -1; }
+  if(dskf) P_close(dskf);
