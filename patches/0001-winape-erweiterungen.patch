+
+bool CapriceSettings::HandleMessage(CMessage* pMessage)
+{
+  bool bHandled = false;
+  if (pMessage) {
+    switch (pMessage->MessageType()) {
+      case CMessage::CTRL_SINGLELCLICK:
+        {
+          CWindow* source = dynamic_cast<CWindow*>(const_cast<CMessageClient*>(pMessage->Source()));
+          if (pMessage->Source() == m_pButtonCancel) {
+            CloseFrame();
+            bHandled = true;
+          } else if (pMessage->Source() == m_pButtonOk || pMessage->Source() == m_pButtonSave) {
+            ApplyToCPC();
+            m_bAccepted = true;
+            m_bSave = (pMessage->Source() == m_pButtonSave);
+            CloseFrame();
+            bHandled = true;
+          } else if (pMessage->Source() == m_pButtonHelp) {
+            ShowHelp();
+            bHandled = true;
+          } else {
+            if (HandleBrowse(pMessage->Source())) {
+              bHandled = true;
+            } else if (source == m_pRomDisableAll || source == m_pRomDisableMost) {
+              for (size_t i = 0; i < m_pRomButtons.size(); ++i) {
+                if (source == m_pRomDisableAll || (i != 0 && i != 7)) {
+                  m_pRomButtons[i]->SetWindowText("...");
+                }
+              }
+              bHandled = true;
+            }
+            for (size_t i = 0; i < m_pRomButtons.size() && !bHandled; ++i) {
+              if (source == m_pRomButtons[i]) {
+                OpenRomSlot(static_cast<unsigned int>(i));
+                bHandled = true;
+              } else if (source == m_pRomClear[i]) {
+                m_pRomButtons[i]->SetWindowText("...");
+                bHandled = true;
+              }
+            }
+          }
+        }
+        break;
+
+      case CMessage::CTRL_VALUECHANGE:
+      case CMessage::CTRL_VALUECHANGING:
+        if (pMessage->Source() == m_pNavigationBar) {
+          SelectPage(m_pNavigationBar->getSelectedIndex());
+        } else {
+          UpdateValueLabels();
+          UpdateRamTotal();
+          if (m_pPanelPdf) {
+            ShowPrinterPanel();
+          }
+        }
+        break;
+
+      case CMessage::KEYBOARD_KEYDOWN:
+        {
+          CKeyboardMessage* key = dynamic_cast<CKeyboardMessage*>(pMessage);
+          if (key && m_bVisible && key->Key == SDLK_ESCAPE) {
+            CloseFrame();
+            bHandled = true;
+          }
+        }
+        break;
+
+      default:
+        break;
+    }
+  }
+  if (!bHandled) {
+    bHandled = CFrame::HandleMessage(pMessage);
+  }
+  return bHandled;
+}
