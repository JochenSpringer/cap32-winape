+/* ---------- HTTP (einfach, ohne TLS, blockierend) ---------- */
+typedef int (*http_cb)(const u8*,int,void*);
+static int http_get(const char*spec,u32 offset,http_cb cb,void*ctx,int*status){
+  char host[260]; char path[400]; u16 port=80; int i=0,k=0; const char*p=spec;
+  if(p[0]=='h'&&p[1]=='t'&&p[2]=='t'&&p[3]=='p'&&p[4]==':'&&p[5]=='/'&&p[6]=='/') p+=7;
