+void CapriceSettings::BuildDisplay(CGroupBox* page)
+{
+  // Monitor type (bare radio buttons on the page, as in WinAPE)
+  m_colour = AddRadio(page, 14, 6, "Colour", CPC.scr_tube == 0);
+  m_green = AddRadio(page, 14, 6, "Green", CPC.scr_tube == 1);
+  m_grey = AddRadio(page, 14, 6, "Greyscale", CPC.scr_tube == 2);
+  m_colour.radio->MoveWindow(CPoint(0, 0));
+  m_colour.label->MoveWindow(CPoint(16, 1));
+  m_green.radio->MoveWindow(CPoint(90, 0));
+  m_green.label->MoveWindow(CPoint(106, 1));
+  m_grey.radio->MoveWindow(CPoint(180, 0));
+  m_grey.label->MoveWindow(CPoint(196, 1));
+
+  // ---- Caprice32 video ----
+  m_sGroupName = "Video";
+  CGroupBox* video = AddGroup(page, 8, 30, 296, 176, "Video");
+  AddLabel(video, 8, 6, "Video plugin");
+  m_pPlugin = new CDropDown(CRect(CPoint(90, 4), 196, 16), video, false);
+  unsigned int index = 0;
+  int selected = 0;
+  for (const auto& plugin : video_plugin_list) {
+    if (!plugin.hidden) {
+      m_pPlugin->AddItem(SListItem(plugin.name));
+      m_pluginIndex.push_back(index);
+      if (index == CPC.scr_style) {
+        selected = static_cast<int>(m_pluginIndex.size()) - 1;
+      }
+    }
+    ++index;
+  }
+  m_pPlugin->SetListboxHeight(std::min<int>(static_cast<int>(m_pluginIndex.size()), 8));
+  m_pPlugin->SelectItem(static_cast<unsigned int>(selected));
+  m_pPlugin->SetIsFocusable(true);
+  AddLabel(video, 8, 30, "Scale");
+  std::vector<std::string> scales;
+  for (int s = 1; s <= 8; ++s) {
+    scales.push_back(std::to_string(s) + "x");
+  }
+  m_pScale = AddDropDown(video, 90, 28, 60, scales, static_cast<int>(CPC.scr_scale) - 1);
+  m_aspect = AddCheck(video, 8, 56, "Preserve aspect ratio", CPC.scr_preserve_aspect_ratio == 1);
+
+  // ---- Screen ----
+  m_sGroupName = "Screen";
+  CGroupBox* screen = AddGroup(page, 316, 30, 288, 86, "Screen");
+  m_fullscreen = AddCheck(screen, 10, 6, "Full screen", CPC.scr_window == 0);
+  m_led = AddCheck(screen, 10, 26, "On-screen drive LED", CPC.scr_led == 1);
+  m_fps = AddCheck(screen, 10, 46, "Show emulation speed", CPC.scr_fps == 1);
+
+  // ---- Brightness ----
+  m_sGroupName = "Brightness";
+  CGroupBox* bright = AddGroup(page, 316, 124, 288, 42, "Brightness");
+  m_pBrightness = AddSlider(bright, 10, 2, 220, 5, 15, 1, static_cast<int>(CPC.scr_intensity));
+  char text[8];
+  snprintf(text, sizeof(text), "%2.1f", CPC.scr_intensity / 10.0);
+  m_pBrightnessValue = AddLabel(bright, 244, 2, text);
+  m_sGroupName = "";
+}
