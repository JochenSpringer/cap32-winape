+  m_prnPdf = AddRadio(printer, 195, 13 - GY + 1, "PDF", pdf);
+  m_prnFile = AddRadio(printer, 11, 31 - GY + 1, "File", file);
+  m_prn8bit = AddCheck(printer, 200, 32 - GY + 1, "8-bit (HW mod)", CPC.printer_8bit == 1);
+
+  // panels (one is visible, depending on the selected radio button)
+  m_pPanelPdf = new CWindow(CRect(CPoint(2, 36), 292, 22), printer);
+  m_pPdfModel = AddDropDown(m_pPanelPdf, 4, 2, 172, {}, -1);
+  for (int i = 0; i < pdfprinter_model_count(); ++i) {
+    m_pPdfModel->AddItem(SListItem(pdfprinter_model_name(i)));
+    if (CPC.printer_pdf_model == pdfprinter_model_id(i)) {
+      m_pPdfModel->SelectItem(static_cast<unsigned int>(i));
+    }
+  }
+  m_pPdfModel->SetListboxHeight(std::min(8, pdfprinter_model_count()));
+  if (m_pPdfModel->GetSelectedIndex() < 0) {
+    m_pPdfModel->SelectItem(0);
+  }
+  m_pPdfPaper = AddDropDown(m_pPanelPdf, 180, 2, 108, {}, -1);
+  for (int i = 0; i < pdfprinter_paper_count(); ++i) {
+    m_pPdfPaper->AddItem(SListItem(pdfprinter_paper_name(i)));
+    if (CPC.printer_pdf_paper == pdfprinter_paper_id(i)) {
+      m_pPdfPaper->SelectItem(static_cast<unsigned int>(i));
+    }
+  }
+  m_pPdfPaper->SetListboxHeight(pdfprinter_paper_count());
+  if (m_pPdfPaper->GetSelectedIndex() < 0) {
+    m_pPdfPaper->SelectItem(0);
+  }
+
+  m_pPanelFile = new CWindow(CRect(CPoint(2, 36), 292, 22), printer);
+  m_pPrinterFile = AddEdit(m_pPanelFile, 4, 2, 264, CPC.printer_file);
+  AddBrowse(m_pPanelFile, 272, 2, m_pPrinterFile, "printout", "Printer output file", "Printer output", "*.*", FileDialogMode::SAVE);
+
+  ShowPrinterPanel();
+
+  // ---- Other Devices ----
+  m_sGroupName = "Other Devices";
+  CGroupBox* devices = AddGroup(page, 316, 70, 288, 36, "Other Devices");
+  m_net4cpc = AddCheck(devices, 9, 4, "Net4CPC ethernet emulation", CPC.net4cpc == 1);
