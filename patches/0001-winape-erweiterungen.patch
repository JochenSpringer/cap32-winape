+      joinp(p2,f->dir,bak); P_rename(p2,p1); }
+  }
+  joinp(p1,f->dir,f->tmp); joinp(p2,f->dir,fin);
+  if(P_rename(p2,p1)!=0){ P_delete(p2); P_rename(p2,p1); }
+}
