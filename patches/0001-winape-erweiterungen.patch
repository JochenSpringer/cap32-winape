+static int dsk_namecmp(const u8*e,const char*n8,const char*e3){ for(int i=0;i<8;i++) if((e[1+i]&0x7F)!=(u8)n8[i]) return 0; for(int i=0;i<3;i++) if((e[9+i]&0x7F)!=(u8)e3[i]) return 0; return 1; }
+static void dsk_entname(const u8*e,char*o){ int k=0; for(int i=0;i<8;i++){ char c=e[1+i]&0x7F; if(c!=' ') o[k++]=c; } int x=0; for(int i=0;i<3;i++) if((e[9+i]&0x7F)!=' ') x=1; if(x){ o[k++]='.'; for(int i=0;i<3;i++){ char c=e[9+i]&0x7F; if(c!=' ') o[k++]=c; } } o[k]=0; }
+static int dsk_valid(const u8*e){ return e[0]==0 && e[1]!=0xE5 && (e[1]&0x7F)>' '; }
+static int dsk_total_records(const u8*e0){
