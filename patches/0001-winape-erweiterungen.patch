diff --git a/src/pe/include/pe/font.h b/src/pe/include/pe/font.h
new file mode 100644
index 0000000..6c74865
--- /dev/null
+++ b/src/pe/include/pe/font.h
@@ -0,0 +1,57 @@
+/*
+ * Bitmap fonts for the emulated print heads.
+ *
+ * A glyph is stored column major, which is how a dot matrix printer actually
+ * draws it: one uint32_t per dot column, bit 0 = topmost wire.  The tables in
+ * src/fonts/ are generated by tools/mkfont.py from the editable .pef sources
+ * and the LQMATRIX soft fonts in core/fonts.
+ */
+#ifndef PE_FONT_H
+#define PE_FONT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+  const char *name;
+  uint8_t pins;        /* wires spanned by the cell (9 or 24)          */
+  uint8_t width;       /* dot columns per glyph slot                   */
+  uint8_t cell;        /* dot columns per character cell, incl. spacing*/
+  uint8_t baseline;    /* row index of the baseline                    */
+  uint16_t count;
+  const uint16_t *codes;  /* sorted, `count` entries                   */
+  const uint32_t *cols;   /* count * width columns                     */
+  const uint8_t *advance; /* proportional advance in columns, bearings
+                             included, `count` entries                 */
+  uint16_t vres;          /* vertical wire pitch in dpi, 0 = printer default */
+  uint8_t dot;            /* dot diameter in units, 0 = printer default      */
+} pe_font;
+
+/*
+ * Look up a glyph.  Returns the column array (font->width entries) and
+ * optionally its proportional advance.  Unknown codes fall back to the
+ * space glyph, so this never returns NULL for a usable font.
+ */
+/* 1 if the font really has this glyph (pe_font_glyph falls back to space). */
+int pe_font_has(const pe_font *font, uint16_t code);
+
+const uint32_t *pe_font_glyph(const pe_font *font, uint16_t code,
+                              uint8_t *advance);
+
+extern const pe_font pe_font_draft9;  /* 9 wire draft, 120 dpi cell     */
+extern const pe_font pe_font_lq24;    /* 24 wire draft                  */
+
+/* 24 wire letter quality typefaces; _ps is the proportional artwork. */
+extern const pe_font pe_font_prestige, pe_font_prestige_ps;
+extern const pe_font pe_font_sans, pe_font_sans_ps;
+extern const pe_font pe_font_script, pe_font_script_ps;
+extern const pe_font pe_font_ocrb;
+extern const pe_font pe_font_ocra;
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PE_FONT_H */
diff --git a/src/pe/include/pe/pe.h b/src/pe/include/pe/pe.h
new file mode 100644
index 0000000..093cf8e
--- /dev/null
+++ b/src/pe/include/pe/pe.h
@@ -0,0 +1,81 @@
+/*
+ * Printer emulation core: page engine, PDF output and job API.
+ *
+ * Units: all coordinates are in 1/2160 inch (the common multiple of the
+ * pitches of 9 and 24 wire heads and of the ESC/P vertical units).
+ */
+#ifndef PE_PE_H
+#define PE_PE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PE_UNITS_PER_INCH 2160
+
+typedef enum {
+  PE_PAPER_A4 = 0,        /* single sheet DIN A4, 210 x 297 mm        */
+  PE_PAPER_A4_ENDLOS = 1, /* fanfold 12" x 240 mm (A4 hoch), 15 mm Lochrand   */
+  PE_PAPER_LETTER = 2,
+  PE_PAPER_A4_ENDLOS_GRUEN = 3 /* fanfold as 1, with green/white reading bars */
+} pe_paper;
+
+typedef struct {
+  int32_t page_width, page_height; /* paper size (fanfold: current form length) */
+  int32_t base_page_height;        /* page_height after power up / ESC @ */
+  int32_t left_offset, top_offset; /* unprintable border                */
+  int continuous;                  /* fanfold paper                     */
+  int greenbar;                    /* green/white reading bars (Lesestreifen) */
+  int32_t text_dy;                 /* set by pe_job_create from the driver's fanfold_dy:
+                                      printed dots sit this much lower than the line grid */
+  int compress;                    /* Flate compress page streams       */
+} pe_config;
+
+void pe_config_init(pe_config *cfg, pe_paper paper);
+
+struct pe_pdf;
+struct pe_driver;
+
+typedef struct pe_engine {
+  pe_config cfg;
+  int32_t x, y; /* head position, owned by the driver */
+
+  /* private */
+  struct pe_pdf *pdf;
+  uint8_t *buf;
+  size_t len, cap;
+  int in_text;
+  int32_t cur_d, px, py;
+  unsigned long ink;
+  int pages;
+} pe_engine;
+
+void pe_engine_dot(pe_engine *e, int32_t x, int32_t y, int32_t diameter);
+void pe_engine_column(pe_engine *e, int32_t x, int32_t y, uint32_t bits,
+                      int pins, int32_t pitch, int32_t diameter);
+void pe_engine_hrule(pe_engine *e, int32_t x0, int32_t x1, int32_t y,
+                     int32_t thickness);
+/* End the current page.  A page without ink is dropped unless `force`. */
+void pe_engine_form_feed(pe_engine *e, int force);
+
+/* Unique output name "<dir>/<prefix>_YYYYMMDD_HHMMSS.pdf" (adds _2, _3 on
+ * collision).  Returns 1 on success. */
+int pe_timestamp_path(char *out, size_t n, const char *dir, const char *prefix);
+
+/* ---- job API: one print job produces one PDF file ------------------- */
+typedef struct pe_job pe_job;
+
+pe_job *pe_job_create(const struct pe_driver *drv, const pe_config *cfg,
+                      const char *pdf_path);
+void pe_job_write(pe_job *j, const uint8_t *data, size_t n);
+void pe_job_reset(pe_job *j); /* hardware INIT line */
+/* Finish the job, close the PDF, free everything.  Returns page count. */
+int pe_job_finish(pe_job *j);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
