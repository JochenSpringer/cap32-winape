+++ b/src/filedialog.h
@@ -0,0 +1,22 @@
+// Native file selection (PC folder structure) with remembered folders.
+#ifndef FILEDIALOG_H
+#define FILEDIALOG_H
+
+#include <string>
+
+// Kinds: "dsk", "tape", "snap", "cart", "rom", "file", ...
+// Shows the operating system's file dialog (Windows: standard dialog, Linux: zenity or kdialog).
+// Returns the chosen full path, or "" if cancelled. If no native dialog exists, available is set to false.
+enum class FileDialogMode { OPEN, SAVE, FOLDER };
+std::string filedialog_pick(const std::string& kind, const std::string& title, const std::string& filter_name,
+                            const std::string& filter_patterns /* e.g. "*.dsk;*.DSK" */, bool& available,
+                            const std::string& default_dir = "", FileDialogMode mode = FileDialogMode::OPEN);
+
+// Last folder used for a kind (persisted between runs); default_dir if none.
+std::string filedialog_dir(const std::string& kind, const std::string& default_dir = "");
+void filedialog_set_dir(const std::string& kind, const std::string& dir_or_file);
+
+// Absolute names are used as they are, relative ones are looked up in dir.
+std::string filedialog_resolve(const std::string& dir, const std::string& name);
+
+#endif
