+
+void CapriceSettings::OpenRomSlot(unsigned int slot)
+{
+  bool available = true;
+  std::string file = filedialog_pick("rom", "Select ROM for slot " + stdex::itoa(static_cast<int>(slot)), "ROM files",
+                                     "*.rom;*.ROM;*.bin;*.BIN", available, CPC.rom_path);
+  if (available) {
+    if (!file.empty()) {
+      // files in the ROM folder are stored by name, all others with their full path
+      std::string romDir = CPC.rom_path;
+      std::error_code ec;
+      if (std::filesystem::equivalent(std::filesystem::path(file).parent_path(), std::filesystem::path(romDir), ec) && !ec) {
+        file = std::filesystem::path(file).filename().string();
+      }
+      m_pRomButtons.at(slot)->SetWindowText(file);
+    }
+    return;
+  }
+  new CapriceRomSlots(CRect(CPoint(SETTINGS_WIDTH / 2 - 125, 40), 250, 200), this, nullptr, "", static_cast<int>(slot), m_pRomButtons.at(slot));
+}
