diff --git a/src/gui/includes/CapriceSettings.h b/src/gui/includes/CapriceSettings.h
new file mode 100644
index 0000000..9360e21
--- /dev/null
+++ b/src/gui/includes/CapriceSettings.h
@@ -0,0 +1,191 @@
+// 'Settings' window for Caprice32: the pages and settings of the WinAPE setup dialog
+// (General, Display, Sound, Memory, Input, Other).
+//
+// WinAPE settings that Caprice32 does not have are shown grayed out, so that nothing is missing from the
+// overview. Settings that only exist in Caprice32 are placed on the page they belong to.
+// The window is a separate OS window (like the developer tools), it is not drawn into the emulator screen.
+#ifndef _WG_CAPRICE32SETTINGS_H_
+#define _WG_CAPRICE32SETTINGS_H_
+
+#include <string>
+#include <vector>
+#include "wg_button.h"
+#include "wg_checkbox.h"
+#include "wg_dropdown.h"
+#include "wg_editbox.h"
+#include "wg_frame.h"
+#include "wg_groupbox.h"
+#include "wg_label.h"
+#include "wg_navigationbar.h"
+#include "wg_radiobutton.h"
+#include "wg_scrollbar.h"
+#include "wg_view.h"
+#include "cap32.h"
+#include "filedialog.h"
+
+constexpr int SETTINGS_WIDTH = 640;
+constexpr int SETTINGS_HEIGHT = 424;
+
+namespace wGui
+{
+    class CapriceSettings : public CFrame {
+      public:
+        //! \param pParent A pointer to the parent view
+        CapriceSettings(const CRect& WindowRect, CWindow* pParent, CFontEngine* pFontEngine);
+        ~CapriceSettings() override;
+
+        bool HandleMessage(CMessage* pMessage) override;
+
+        //! Ends the settings application (the window is closed by the caller)
+        void CloseFrame() override;
+
+        //! Show page 0 (General) ... 5 (Other)
+        void SelectPage(unsigned int index);
+
+        //! true if OK or Save was clicked: the new values are then already stored in CPC
+        bool Accepted() const { return m_bAccepted; }
+        //! true if Save was clicked: the configuration should be written to cap32.cfg
+        bool SaveRequested() const { return m_bSave; }
+
+        //! Description ("Page / Group: Control") of every WinAPE setting that is shown grayed out
+        const std::vector<std::string>& Unavailable() const { return m_unavailable; }
+
+      private:
+        // ---- building the pages ----
+        void BuildGeneral(CGroupBox* page);
+        void BuildDisplay(CGroupBox* page);
+        void BuildSound(CGroupBox* page);
+        void BuildMemory(CGroupBox* page);
+        void BuildInput(CGroupBox* page);
+        void BuildOther(CGroupBox* page);
+
+        // A control with its label. Controls that Caprice32 has no equivalent for are created
+        // with available=false: grayed out, not clickable, not focusable.
+        struct CheckItem { CCheckBox* box; CLabel* label; bool available; };
+        struct RadioItem { CRadioButton* radio; CLabel* label; bool available; };
+        CheckItem AddCheck(CWindow* parent, int x, int y, const std::string& text, bool value, bool available = true);
+        RadioItem AddRadio(CWindow* parent, int x, int y, const std::string& text, bool value, bool available = true);
+        CLabel* AddLabel(CWindow* parent, int x, int y, const std::string& text, bool available = true);
+        CDropDown* AddDropDown(CWindow* parent, int x, int y, int w, const std::vector<std::string>& items, int selected, bool available = true);
+        CScrollBar* AddSlider(CWindow* parent, int x, int y, int w, int min, int max, int step, int value, bool available = true);
+        CEditBox* AddEdit(CWindow* parent, int x, int y, int w, const std::string& text, bool available = true, bool readOnly = false);
+        CButton* AddButton(CWindow* parent, int x, int y, int w, int h, const std::string& text, bool available = true);
+        CGroupBox* AddGroup(CWindow* parent, int x, int y, int w, int h, const std::string& caption);
+        void Gray(CWindow* window, const std::string& what);   // disable + remember in m_unavailable
+
+        // ---- helpers ----
+        void ShowPrinterPanel();
+        void UpdateRamTotal();
+        void UpdateValueLabels();
+        void OpenRomSlot(unsigned int slot);
+        // "..." buttons next to an edit box: show the PC's file dialog
+        struct BrowseItem { CButton* button; CEditBox* edit; std::string kind, title, filterName, patterns; FileDialogMode mode; std::string defaultDir; };
+        CButton* AddBrowse(CWindow* parent, int x, int y, CEditBox* edit, const std::string& kind, const std::string& title,
+                           const std::string& filterName, const std::string& patterns, FileDialogMode mode = FileDialogMode::OPEN, const std::string& defaultDir = "");
+        bool HandleBrowse(const CMessageClient* source);
+        std::vector<BrowseItem> m_browse;
+        std::vector<CButton*> m_pRomClear;
+        static bool Checked(const CheckItem& item) { return item.box->GetCheckBoxState() == CCheckBox::CHECKED; }
+        static bool Checked(const RadioItem& item) { return item.radio->GetState() == CRadioButton::CHECKED; }
+        void ApplyToCPC();       // copies the controls to the global CPC (called by OK and Save)
+        void ShowHelp();
+
+        // ---- window structure ----
+        CNavigationBar* m_pNavigationBar = nullptr;
+        std::vector<CGroupBox*> m_pages;
+        unsigned int m_iPage = 0;
+        std::string m_sPageName;     // for the list of unavailable settings
+        std::string m_sGroupName;
+        std::vector<std::string> m_unavailable;
+        CButton* m_pButtonOk = nullptr;
+        CButton* m_pButtonCancel = nullptr;
+        CButton* m_pButtonSave = nullptr;
+        CButton* m_pButtonHelp = nullptr;
+        bool m_bAccepted = false;
+        bool m_bSave = false;
+        bool m_bInitialPlus = false;
+
