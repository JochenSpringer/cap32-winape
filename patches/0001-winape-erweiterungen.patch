+/* ---------- Dateien: Host-Ordner + DSK-Images (AMSDOS-konformes Verhalten) ---------- */
+#define NFD 16
+typedef struct {
+  int kind;                 /* 0 frei, 1 Host-Datei, 2 DSK-Datei (Speicher), 3 Host-Datei im Schreibmodus (AMSDOS-Stil) */
+  void *h; u8 *mem; u32 size, pos;
+  char dir[256], tmp[270], base[270], given[270]; int noext, blankext;
+} FD;
+static FD fds[NFD];
+static u8 dskmem[2][0x20000];
+static int in_dsk; static char dskname[260];
