+static void cpystr(char*d,const char*s,int max){ int i=0; while(s[i]&&i<max-1){ d[i]=s[i]; i++; } d[i]=0; }
+static int lastdot(const char*s){ int r=-1; for(int i=0;s[i];i++) if(s[i]=='.') r=i; return r; }
+static int eqci(const char*a,const char*b){ while(*a&&*b){ if(lc(*a)!=lc(*b)) return 0; a++; b++; } return *a==*b; }
+static void upcase(char*s){ for(;*s;s++) if(*s>='a'&&*s<='z') *s-=32; }
+static int haswild(const char*s){ for(;*s;s++) if(*s=='*'||*s=='?') return 1; return 0; }
+/* "NAME    .EXT" (12 Zeichen) aus Hostnamen */
+static void to83(const char*host,char o[13]){
+  int dot=lastdot(host); int nl=dot>0?dot:(int)strlen(host); int i,k=0;
+  for(i=0;i<8;i++){ char c=(i<nl)?host[i]:' '; if(c>='a'&&c<='z') c-=32; o[k++]=c; }
+  o[k++]='.';
+  for(i=0;i<3;i++){ char c=(dot>0&&host[dot+1+i]&&(int)strlen(host)>dot+1+i)?host[dot+1+i]:' '; if(c>='a'&&c<='z') c-=32; o[k++]=c; }
+  o[k]=0;
+}
+/* "NAME.EXT" ohne Leerzeichen (fuer Mustervergleich) */
+static void trim83(const char*host,char*o){
+  char t[13]; to83(host,t); int k=0; for(int i=0;i<8;i++) if(t[i]!=' ') o[k++]=t[i];
+  int e=0; for(int i=9;i<12;i++) if(t[i]!=' ') e=1;
+  if(e){ o[k++]='.'; for(int i=9;i<12;i++) if(t[i]!=' ') o[k++]=t[i]; }
+  o[k]=0;
+}
+static int match_name(const char*pat,const char*host){
+  char t[16]; trim83(host,t);
+  if(eqci(pat,"*.*")) return 1;
+  return wild(pat,host)||wild(pat,t);
+}
+static void joinp(char*o,const char*dir,const char*f){ int n=0; for(const char*c=dir;*c&&n<250;) o[n++]=*c++; if(n&&*f) o[n++]='/'; for(const char*c=f;*c&&n<510;) o[n++]=*c++; o[n]=0; }
+/* Datei oder Ordner im Host-Verzeichnis dir suchen (Gross/Klein egal, auch 8.3-Form). 1 = gefunden */
+static int find_host(const char*dir,const char*name,char*out,int*isdir,u32*size){
+  P_ent e; void*h=P_findfirst(dir,&e); if(!h) return 0;
+  char n83[13],e83[13]; to83(name,n83); int wl=haswild(name); int ok=1, best=0; char bn[260]; int bd=0; u32 bs=0;
+  while(ok){
+    int sc=0;
+    if(eqci(e.name,name)) sc=3;
+    else if(wl&&match_name(name,e.name)) sc=1;
+    else if(!wl){ to83(e.name,e83); if(!memcmp(n83,e83,12)) sc=2; }
+    if(sc>best){ best=sc; cpystr(bn,e.name,260); bd=(e.attr&0x10)?1:0; bs=e.size; if(sc==3) break; }
+    ok=P_findnext(h,&e);
+  }
+  P_findclose(h);
+  if(!best) return 0; cpystr(out,bn,260); if(isdir) *isdir=bd; if(size) *size=bs; return 1;
+}
+/* Pfad des CPC (relativ zu curdir) in Ordner + Dateiname zerlegen */
+static int splitp(const char*name,char*dir,char*file){
+  char p[256]; if(!mkpath(name,p)) return 0;
+  int sl=-1; for(int i=0;p[i];i++) if(p[i]=='/') sl=i;
+  if(sl<0){ dir[0]=0; cpystr(file,p,260); } else { int i; for(i=0;i<sl;i++) dir[i]=p[i]; dir[i]=0; cpystr(file,p+sl+1,260); }
+  return 1;
+}
