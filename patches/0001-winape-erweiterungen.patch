+CapriceSettings::~CapriceSettings() = default;
+
+void CapriceSettings::CloseFrame()
+{
+  Application().MessageServer()->QueueMessage(new CMessage(CMessage::APP_EXIT, nullptr, this));
+}
+
+void CapriceSettings::SelectPage(unsigned int index)
+{
+  for (size_t i = 0; i < m_pages.size(); ++i) {
+    m_pages[i]->SetVisible(i == index);
+  }
+  m_iPage = index;
+  if (m_pNavigationBar && m_pNavigationBar->getSelectedIndex() != index) {
+    m_pNavigationBar->SelectItem(index);
+  }
+  if (m_pPanelPdf) {
+    ShowPrinterPanel(); // showing a page makes all of its children visible again
+  }
+}
