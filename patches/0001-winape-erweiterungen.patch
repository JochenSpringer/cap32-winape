+/* ---------- Pfade ---------- */
+static int lc(int c){ return (c>='A'&&c<='Z')?c+32:c; }
+static int wild(const char*p,const char*s){
+  while(*p){
+    if(*p=='*'){ p++; if(!*p) return 1; while(*s){ if(wild(p,s)) return 1; s++; } return 0; }
+    if(!*s) return 0;
+    if(*p!='?' && lc(*p)!=lc(*s)) return 0;
+    p++; s++;
+  }
+  return *s==0;
+}
+/* normalisiert in out (relativ, '/'), 0 bei Ausbruch aus der Wurzel */
+static int normpath(const char*in,char*out,int outsz){
+  char tmp[512]; int n=0; const char*p=in;
+  if(*p=='/'||*p=='\\'){ p++; } else { for(const char*c=curdir;*c&&n<250;) tmp[n++]=*c++; if(n) tmp[n++]='/'; }
+  while(*p&&n<500){ tmp[n++]=(*p=='\\')?'/':*p; p++; }
+  tmp[n]=0;
+  int o=0, d=0; int mark[64]; out[0]=0; char*q=tmp;
+  while(*q){
+    while(*q=='/') q++;
+    if(!*q) break;
+    char*s=q; while(*q&&*q!='/') q++;
+    int l=(int)(q-s);
+    if(l==1&&s[0]=='.') continue;
+    if(l==2&&s[0]=='.'&&s[1]=='.'){ if(d==0) return 0; d--; o=mark[d]; out[o]=0; continue; }
+    if(d>=63||o+l+2>outsz) return 0;
+    mark[d++]=o;
+    if(o) out[o++]='/';
+    memcpy(out+o,s,l); o+=l; out[o]=0;
+  }
+  return 1;
+}
+static int mkpath(const char*in,char*out){ return normpath(in,out,256); }
