+// M4 board (Duke) emulation: the board's SD card, network and HTTP functions are provided by the host.
+// The original M4 ROM runs unchanged in expansion ROM slot 6; this code answers its commands on ports &FE00/&FC00.
+#ifndef M4_H
+#define M4_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int m4_enabled;
+void m4_port_write(unsigned int porthi, unsigned int data);
+void m4_set_rom(unsigned char* rom16k);   // the 16 KB image of the M4 ROM (answers are written into it)
+void m4_set_root(const char* directory);  // directory that serves as the "SD card"
+void m4_set_log(int on);                  // 1 = log commands to stderr
+#ifdef __cplusplus
+}
+#endif
+
+#endif
