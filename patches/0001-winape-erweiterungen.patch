+// ============================================================================================
+// Value labels, OK / Save
+// ============================================================================================
+
+void CapriceSettings::UpdateValueLabels()
+{
+  m_pSpeedValue->SetWindowText(stdex::itoa(m_pSpeed->GetValue() * 25) + "%");
+  m_pVolumeValue->SetWindowText(stdex::itoa(m_pVolume->GetValue()) + "%");
+  char text[8];
+  snprintf(text, sizeof(text), "%2.1f", m_pBrightness->GetValue() / 10.0);
+  m_pBrightnessValue->SetWindowText(text);
+}
+
+void CapriceSettings::ApplyToCPC()
+{
+  // ---- General ----
+  CPC.speed = static_cast<unsigned int>(m_pSpeed->GetValue());
+  CPC.limit_speed = Checked(m_turbo) ? 0 : 1;
+  CPC.display_every = static_cast<unsigned int>(m_pDisplayEvery->GetSelectedIndex() + 1);
+  CPC.auto_pause = Checked(m_autoPause) ? 1 : 0;
+  int model = m_pModel->GetSelectedIndex();
+  if (Checked(m_plus) != m_bInitialPlus) {
+    // the Plus checkbox was changed: it decides between CPC 6128+ and 6128
+    model = Checked(m_plus) ? 3 : (model == 3 ? 2 : model);
+  }
+  CPC.model = static_cast<unsigned int>(model);
+
+  // ---- Memory ----
+  if (Checked(m_ram64)) {
+    CPC.ram_size = 64;
+  } else if (Checked(m_ram128)) {
+    CPC.ram_size = 128;
+  } else if (Checked(m_ram320)) {
+    CPC.ram_size = 320;
+  } else if (Checked(m_ram576)) {
+    CPC.ram_size = 576;
+  }
+  if (CPC.model >= 2 && CPC.ram_size < 128) {
+    CPC.ram_size = 128; // the 6128 has at least 128K
+  }
+  for (size_t i = 0; i < m_pRomButtons.size(); ++i) {
+    const std::string name = m_pRomButtons[i]->GetWindowText();
+    CPC.rom_file[i] = (name == "...") ? "" : name;
+  }
+
+  // ---- Display ----
+  CPC.scr_tube = Checked(m_grey) ? 2 : (Checked(m_green) ? 1 : 0);
+  CPC.scr_intensity = static_cast<unsigned int>(m_pBrightness->GetValue());
+  const int plugin = m_pPlugin->GetSelectedIndex();
+  if (plugin >= 0 && plugin < static_cast<int>(m_pluginIndex.size())) {
+    CPC.scr_style = m_pluginIndex[static_cast<size_t>(plugin)];
+  }
+  CPC.scr_scale = static_cast<unsigned int>(m_pScale->GetSelectedIndex() + 1);
+  CPC.scr_preserve_aspect_ratio = Checked(m_aspect) ? 1 : 0;
+  CPC.scr_fps = Checked(m_fps) ? 1 : 0;
+  CPC.scr_window = Checked(m_fullscreen) ? 0 : 1;
+  CPC.scr_led = Checked(m_led) ? 1 : 0;
+
+  // ---- Sound ----
+  CPC.snd_enabled = Checked(m_soundSdl) ? 1 : 0;
+  CPC.snd_playback_rate = static_cast<unsigned int>(m_pRate->GetSelectedIndex());
+  CPC.snd_bits = Checked(m_bits16) ? 1 : 0;
+  CPC.snd_stereo = Checked(m_stereo) ? 1 : 0;
+  CPC.snd_volume = static_cast<unsigned int>(m_pVolume->GetValue());
+
+  // ---- Input ----
+  CPC.joysticks = Checked(m_joystick) ? 1 : 0;
+  CPC.char_mode = Checked(m_charMode) ? 1 : 0;
+  CPC.char_umlauts = Checked(m_umlauts) ? 1 : 0;
+  CPC.keyboard = static_cast<unsigned int>(m_pCpcLanguage->GetSelectedIndex());
+  const int layout = m_pPcLayout->GetSelectedIndex();
+  if (layout >= 0 && layout < static_cast<int>(m_mapFiles.size())) {
+    CPC.kbd_layout = m_mapFiles[static_cast<size_t>(layout)];
+  }
+  CPC.joystick_emulation = static_cast<JoystickEmulation>(m_pJoystickEmulation->GetSelectedIndex());
+
+  // ---- Other ----
+  const int pdfModel = m_pPdfModel->GetSelectedIndex();
+  if (pdfModel >= 0 && pdfModel < pdfprinter_model_count()) {
+    CPC.printer_pdf_model = pdfprinter_model_id(pdfModel);
+  }
+  const int pdfPaper = m_pPdfPaper->GetSelectedIndex();
+  if (pdfPaper >= 0 && pdfPaper < pdfprinter_paper_count()) {
+    CPC.printer_pdf_paper = pdfprinter_paper_id(pdfPaper);
+  }
+  CPC.printer_file = m_pPrinterFile->GetWindowText();
+  CPC.printer = 0;
+  CPC.printer_pdf = 0;
+  CPC.snd_pp_device = 0;
+  if (Checked(m_prnPdf)) {
+    CPC.printer = 1;
+    CPC.printer_pdf = 1;
+  } else if (Checked(m_prnFile)) {
+    CPC.printer = 1;
+  } else if (Checked(m_prnDigiblaster)) {
+    CPC.snd_pp_device = 1;
+  }
+  CPC.net4cpc = Checked(m_net4cpc) ? 1 : 0;
+  CPC.m4 = Checked(m_m4) ? 1 : 0;
+  CPC.m4_rom = m_pM4Rom->GetWindowText();
+  CPC.m4_root = m_pM4Root->GetWindowText();
+  CPC.printer_8bit = Checked(m_prn8bit) ? 1 : 0;
+  CPC.printer_sound = Checked(m_sndPrinter) ? 1 : 0;
+  CPC.mf2 = Checked(m_multiface) ? 1 : 0;
+  CPC.rom_mf2 = m_pMf2Rom->GetWindowText();
+  g_cartToLoad = (Checked(m_cart) && !m_pCartFile->GetWindowText().empty()) ? m_pCartFile->GetWindowText() : "";
+}
