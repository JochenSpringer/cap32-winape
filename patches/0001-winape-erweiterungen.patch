+    cpystr(f->dir,dir,256); cpystr(f->base,b8,270); f->noext=noext; f->blankext=blank;
+    if(!noext&&!blank){ int n=(int)strlen(b8); f->given[0]=0; cpystr(f->given,b8,270); f->given[n]='.'; cpystr(f->given+n+1,e3,8); }
