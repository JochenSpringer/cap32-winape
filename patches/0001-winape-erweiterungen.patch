+constexpr int TABLES = 3;               // normal, shift, control
+constexpr size_t TABLE_BLOCK = TABLE_SIZE * TABLES;
+constexpr unsigned int SCAN_FROM = 0x8000;   // the firmware keeps its tables in the upper RAM
+constexpr unsigned int SCAN_TO = 0xC000;
+constexpr int HOLD_FRAMES = 2;
+constexpr int GAP_FRAMES = 1;
+constexpr size_t MAX_QUEUE = 64;
+
+std::deque<dword> queue;
+dword current = 0xff;
+int state = 0;          // 0 idle, 1 key held, 2 gap
+dword until = 0;
+int cachedOffset = -1;  // where the tables were found last time (RAM address)
+
+const byte* RomTable()
+{
+  if (!pbROMlo) return nullptr;
+  switch (CPC.model) {
+    case 0: return pbROMlo + 0x1d69;                         // 464
+    case 1: case 2: case 3: return pbROMlo + 0x1eef;         // 664, 6128, 6128+
+    default: return nullptr;
+  }
+}
+
+// The firmware copies the tables from the ROM to RAM when it starts and KEY DEF changes them there.
+// So: find the RAM block that is most similar to the ROM table.
+const byte* FindTables()
+{
+  const byte* rom = RomTable();
+  if (!rom || !pbRAM) return nullptr;
+  auto score = [&](unsigned int addr) {
+    int same = 0;
+    for (size_t i = 0; i < TABLE_BLOCK; ++i) {
+      if (pbRAM[addr + i] == rom[i]) ++same;
+    }
+    return same;
+  };
+  const int enough = static_cast<int>(TABLE_BLOCK) * 3 / 4;
+  if (cachedOffset >= 0 && score(static_cast<unsigned int>(cachedOffset)) >= enough) {
+    return pbRAM + cachedOffset;
+  }
+  int best = -1;
+  int bestScore = 0;
+  for (unsigned int addr = SCAN_FROM; addr + TABLE_BLOCK <= SCAN_TO; ++addr) {
+    if (pbRAM[addr] != rom[0] && pbRAM[addr + 1] != rom[1]) continue; // quick reject
+    const int s = score(addr);
+    if (s > bestScore) {
+      bestScore = s;
+      best = static_cast<int>(addr);
+    }
+  }
+  if (best >= 0 && bestScore >= enough) {
+    cachedOffset = best;
+    return pbRAM + best;
+  }
+  cachedOffset = -1;
+  return nullptr;
+}
+
+} // namespace
+
+int charmode_cpc_code(unsigned int cp)
+{
+  if (cp == '\n' || cp == '\r') return 0x0D;
+  if (cp >= 0x20 && cp < 0x7F) return static_cast<int>(cp);
+  if (CPC.char_umlauts) {
+    // The CPC has no umlauts in its ASCII set; the German character set puts them on these positions
+    switch (cp) {
+      case 0xE4: return '{';   // ä
+      case 0xF6: return '|';   // ö
+      case 0xFC: return '}';   // ü
+      case 0xDF: return '~';   // ß
+      case 0xC4: return '[';   // Ä
+      case 0xD6: return '\\';  // Ö
+      case 0xDC: return ']';   // Ü
+      default: break;
+    }
+  }
+  return -1;
+}
+
+dword charmode_scancode_for_code(byte code)
+{
+  const byte* tables = FindTables();
+  if (!tables) return 0xff;
+  for (int t = 0; t < TABLES; ++t) {
+    for (int key = 0; key < TABLE_SIZE; ++key) {
+      if (key == 21 || key == 23) continue; // key numbers of Shift and Control: never "type" those themselves
+      if (tables[t * TABLE_SIZE + key] != code) continue;
+      // table index = row * 8 + bit; hardware scancode = row << 4 | bit
+      const dword scancode = static_cast<dword>(((key >> 3) << 4) | (key & 7));
+      return scancode | (t == 1 ? MOD_CPC_SHIFT : 0) | (t == 2 ? MOD_CPC_CTRL : 0);
+    }
+  }
+  return 0xff;
+}
+
+void charmode_sync_text_input()
+{
+  const bool want = CPC.char_mode != 0;
+  if (want != (SDL_IsTextInputActive() == SDL_TRUE)) {
+    if (want) SDL_StartTextInput(); else SDL_StopTextInput();
+  }
+}
+
+bool charmode_is_text_key(const SDL_Keysym& k)
+{
+  if (!CPC.char_mode) return false;
+  if (k.mod & (KMOD_CTRL | KMOD_LALT | KMOD_GUI)) return false; // shortcuts and CPC COPY/CTRL combinations keep working as keys
+  const SDL_Keycode s = k.sym;
+  if (s == SDLK_SPACE) return false;                              // space is held like a normal key
+  return (s > 0x20 && s < 0x7F) || (s >= 0xA0 && s <= 0xFF);
+}
+
+bool charmode_text_input(const char* utf8)
+{
+  if (!CPC.char_mode || !utf8) return false;
+  const unsigned char* p = reinterpret_cast<const unsigned char*>(utf8);
+  while (*p) {
+    unsigned int cp = 0;
+    int extra = 0;
+    if (*p < 0x80) { cp = *p; extra = 0; }
+    else if ((*p & 0xE0) == 0xC0) { cp = *p & 0x1F; extra = 1; }
+    else if ((*p & 0xF0) == 0xE0) { cp = *p & 0x0F; extra = 2; }
+    else { cp = *p & 0x07; extra = 3; }
+    ++p;
+    for (int i = 0; i < extra && *p; ++i, ++p) cp = (cp << 6) | (*p & 0x3F);
+    const int code = charmode_cpc_code(cp);
+    if (code < 0) continue;                                       // no CPC counterpart: stays unassigned
+    const dword sc = charmode_scancode_for_code(static_cast<byte>(code));
+    if (sc == 0xff) {
+      LOG_DEBUG("Character mode: no CPC key produces character code " << code);
+      continue;
+    }
+    if (queue.size() < MAX_QUEUE) queue.push_back(sc);
+  }
+  return true;
+}
+
+void charmode_update(dword frame)
+{
+  if (state == 1 && frame >= until) {
+    applyKeypress(current, keyboard_matrix, false);
+    state = 2;
+    until = frame + GAP_FRAMES;
+  } else if (state == 2 && frame >= until) {
+    state = 0;
+  }
+  if (state == 0 && !queue.empty()) {
+    current = queue.front();
+    queue.pop_front();
+    applyKeypress(current, keyboard_matrix, true);
+    state = 1;
+    until = frame + HOLD_FRAMES;
+  }
+}
+
+void charmode_reset()
+{
+  queue.clear();
+  if (state == 1) applyKeypress(current, keyboard_matrix, false);
+  state = 0;
+  cachedOffset = -1;
+}
diff --git a/src/charmode.h b/src/charmode.h
new file mode 100644
index 0000000..22599e8
--- /dev/null
+++ b/src/charmode.h
@@ -0,0 +1,29 @@
+// Character mode for the PC keyboard: the character the PC key produces is typed on the CPC,
+// whatever key combination the CPC needs for it (like pasting text, but live).
+// The key combination is looked up in the CPC firmware's *current* key translation tables
+// (normal / shift / ctrl), so KEY DEF changes and national key tables of the running software
+// (e.g. a German word processor) are respected.
+#ifndef CHARMODE_H
+#define CHARMODE_H
+
+#include <SDL.h>
+#include "types.h"
+
+// Make sure SDL text input is active exactly when the mode is enabled (call once per frame)
+void charmode_sync_text_input();
+// SDL_TEXTINPUT event (UTF-8 text typed on the PC keyboard). Returns true if consumed.
+bool charmode_text_input(const char* utf8);
+// SDL_KEYDOWN/SDL_KEYUP: returns true if the key is a text key that is handled as a character
+// (the normal key-to-key translation must then be skipped).
+bool charmode_is_text_key(const SDL_Keysym& keysym);
+// Press/release the queued keys; call once per frame
+void charmode_update(dword frame);
+// Drop everything queued (e.g. after a reset)
+void charmode_reset();
+
+// For tests: scancode (with MOD_CPC_SHIFT / MOD_CPC_CTRL) that makes the CPC produce 'code', or 0xff
+dword charmode_scancode_for_code(byte code);
+// For tests: CPC character code for a Unicode code point (umlauts -> ASCII positions), or -1
+int charmode_cpc_code(unsigned int codepoint);
+
+#endif
diff --git a/src/filedialog.cpp b/src/filedialog.cpp
new file mode 100644
index 0000000..0bbe311
--- /dev/null
+++ b/src/filedialog.cpp
@@ -0,0 +1,195 @@
+#include "filedialog.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <vector>
+
+#ifdef WINDOWS
+#include <windows.h>
+#include <commdlg.h>
+#include <shlobj.h>
+#endif
+
+namespace {
+
+std::map<std::string, std::string>& dirs() {
+  static std::map<std::string, std::string> d;
+  return d;
+}
+
+bool& loaded() { static bool l = false; return l; }
+
+std::string storage_file() {
+#ifdef WINDOWS
+  const char* base = getenv("APPDATA");
+  std::string dir = base ? std::string(base) : std::string(".");
+  return dir + "\\cap32-lastdirs.txt";
+#else
+  const char* xdg = getenv("XDG_CONFIG_HOME");
+  const char* home = getenv("HOME");
+  std::string dir = xdg ? std::string(xdg) : (home ? std::string(home) + "/.config" : std::string("."));
+  return dir + "/cap32-lastdirs.txt";
+#endif
+}
+
+void load() {
+  if (loaded()) return;
+  loaded() = true;
+  std::ifstream in(storage_file());
+  std::string line;
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    auto eq = line.find('=');
+    if (eq == std::string::npos) continue;
+    dirs()[line.substr(0, eq)] = line.substr(eq + 1);
+  }
+}
+
+void save() {
+  std::string file = storage_file();
+  std::error_code ec;
+  std::filesystem::create_directories(std::filesystem::path(file).parent_path(), ec);
+  std::ofstream out(file);
+  for (const auto& d : dirs()) out << d.first << "=" << d.second << "\n";
+}
+
+#ifndef WINDOWS
+std::string shell_quote(const std::string& s) {
+  std::string r = "'";
+  for (char c : s) {
+    if (c == '\'') r += "'\\''"; else r += c;
+  }
+  return r + "'";
+}
+
+bool have_command(const char* name) {
+  std::string cmd = std::string("command -v ") + name + " >/dev/null 2>&1";
+  return system(cmd.c_str()) == 0;
+}
+
+std::string run(const std::string& cmd) {
+  std::string result;
+  FILE* p = popen(cmd.c_str(), "r");
+  if (!p) return result;
+  char buf[512];
+  while (fgets(buf, sizeof(buf), p)) result += buf;
+  pclose(p);
+  while (!result.empty() && (result.back() == '\n' || result.back() == '\r')) result.pop_back();
+  return result;
+}
+#endif
+
+} // namespace
+
+std::string filedialog_dir(const std::string& kind, const std::string& default_dir) {
+  load();
+  auto it = dirs().find(kind);
+  if (it != dirs().end()) {
+    std::error_code ec;
+    if (std::filesystem::is_directory(it->second, ec)) return it->second;
+  }
+  return default_dir;
+}
+
+void filedialog_set_dir(const std::string& kind, const std::string& dir_or_file) {
+  load();
+  std::error_code ec;
+  std::filesystem::path p(dir_or_file);
+  if (!std::filesystem::is_directory(p, ec)) p = p.parent_path();
+  if (p.empty() || !std::filesystem::is_directory(p, ec)) return;
+  std::string d = p.string();
+  if (dirs()[kind] == d) return;
+  dirs()[kind] = d;
+  save();
+}
+
+std::string filedialog_resolve(const std::string& dir, const std::string& name) {
+  if (name.empty()) return name;
+  std::error_code ec;
+  if (std::filesystem::path(name).is_absolute()) return name;
+  return dir + "/" + name;
+}
+
+std::string filedialog_pick(const std::string& kind, const std::string& title, const std::string& filter_name,
+                            const std::string& filter_patterns, bool& available, const std::string& default_dir, FileDialogMode mode) {
+  available = true;
+  std::string start = filedialog_dir(kind, default_dir);
+  std::string result;
+#ifdef WINDOWS
+  char file[MAX_PATH] = "";
+  // filter: "name\0patterns\0All files\0*.*\0\0"
+  std::string filter = filter_name + " (" + filter_patterns + ")";
+  filter.push_back('\0');
+  filter += filter_patterns;
+  filter.push_back('\0');
+  filter += "All files (*.*)";
+  filter.push_back('\0');
+  filter += "*.*";
+  filter.push_back('\0');
+  if (mode == FileDialogMode::FOLDER) {
+    char path[MAX_PATH] = "";
+    BROWSEINFOA bi;
+    ZeroMemory(&bi, sizeof(bi));
+    bi.lpszTitle = title.c_str();
+    bi.ulFlags = BIF_RETURNONLYFSDIRS | BIF_NEWDIALOGSTYLE;
+    LPITEMIDLIST pidl = SHBrowseForFolderA(&bi);
+    if (pidl) {
+      if (SHGetPathFromIDListA(pidl, path)) result = path;
+      CoTaskMemFree(pidl);
+    }
+    if (!result.empty()) filedialog_set_dir(kind, result);
+    return result;
+  }
+  OPENFILENAMEA ofn;
+  ZeroMemory(&ofn, sizeof(ofn));
+  ofn.lStructSize = sizeof(ofn);
+  ofn.hwndOwner = nullptr;
+  ofn.lpstrFilter = filter.c_str();
+  ofn.lpstrFile = file;
+  ofn.nMaxFile = MAX_PATH;
+  ofn.lpstrTitle = title.c_str();
+  std::string dir = start;
+  for (auto& c : dir) if (c == '/') c = '\\';
+  ofn.lpstrInitialDir = dir.empty() ? nullptr : dir.c_str();
+  if (mode == FileDialogMode::SAVE) {
+    ofn.Flags = OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR | OFN_EXPLORER | OFN_OVERWRITEPROMPT;
+    if (GetSaveFileNameA(&ofn)) result = file;
+  } else {
+    ofn.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR | OFN_EXPLORER;
+    if (GetOpenFileNameA(&ofn)) result = file;
+  }
+#else
+  static int tool = -1; // 0 none, 1 zenity, 2 kdialog
+  if (tool < 0) tool = have_command("zenity") ? 1 : (have_command("kdialog") ? 2 : 0);
+  if (tool == 0) { available = false; return ""; }
+  std::string dir = start;
+  if (!dir.empty() && dir.back() != '/') dir += '/';
+  if (tool == 1) {
+    std::string patterns = filter_patterns;
+    for (auto& c : patterns) if (c == ';') c = ' ';
+    std::string cmd = "zenity --file-selection --title=" + shell_quote(title);
+    if (mode == FileDialogMode::SAVE) cmd += " --save --confirm-overwrite";
+    if (mode == FileDialogMode::FOLDER) cmd += " --directory";
+    if (!dir.empty()) cmd += " --filename=" + shell_quote(dir);
+    if (mode != FileDialogMode::FOLDER) {
+      cmd += " --file-filter=" + shell_quote(filter_name + " | " + patterns);
+      cmd += " --file-filter='All files | *'";
+    }
+    cmd += " 2>/dev/null";
+    result = run(cmd);
+  } else {
+    std::string patterns = filter_patterns;
+    for (auto& c : patterns) if (c == ';') c = ' ';
+    const char* verb = mode == FileDialogMode::SAVE ? " --getsavefilename " : (mode == FileDialogMode::FOLDER ? " --getexistingdirectory " : " --getopenfilename ");
+    std::string cmd = "kdialog --title " + shell_quote(title) + verb + shell_quote(dir.empty() ? "." : dir) +
+                      " " + shell_quote(patterns + "|" + filter_name + "\n*|All files") + " 2>/dev/null";
+    result = run(cmd);
+  }
+#endif
+  if (!result.empty()) filedialog_set_dir(kind, result);
+  return result;
+}
diff --git a/src/filedialog.h b/src/filedialog.h
