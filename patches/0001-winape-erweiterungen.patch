+/* ---------- Netzwerk ---------- */
+#define NSOCK 5
+#define SBUF 0x4000
+typedef struct { int h; int len; u8 closed; u8 listening; u8 buf[SBUF]; u8 bip[4]; u16 bport; } Sock;
+static Sock socks[NSOCK];
+static volatile int dns_req; static char dns_name[260];
+
+static void si_set(int s,int off,u8 v){ if(g_rom) sockinfo()[s*16+off]=v; }
+static void si_status(int s,u8 st,u8 last){ if(g_rom){ u8*p=sockinfo()+s*16; p[0]=st; p[1]=last; } }
+static void si_recv(int s){ if(g_rom) wr16(sockinfo()+s*16+2,socks[s].len>0xFFFF?0xFFFF:socks[s].len); }
+
+static void worker(void){
+  for(;;){
+    P_sleep(2);
+    char name[260]; int req=0;
+    LOCK(); if(dns_req){ memcpy(name,dns_name,260); req=1; } UNLOCK();
+    if(req){ u8 ip[4]={0,0,0,0}; int r=P_resolve(name,ip);
+      LOCK(); if(g_rom){ u8*p=sockinfo(); if(r==0){ memcpy(p+4,ip,4); p[0]=0; } else p[0]=0xF2; p[1]=2; } dns_req=0; UNLOCK(); }
+    LOCK();
+    if(g_rom) for(int s=1;s<NSOCK;s++){
+      Sock*k=&socks[s]; if(k->h<0) continue;
+      u8*si=sockinfo()+s*16;
+      if(si[0]==1){ int c=P_sock_cstate(k->h); if(c==1){ si[0]=0; si[1]=3; } else if(c<0){ si[0]=0xF1; si[1]=3; } }
+      else if(si[0]==4){ u8 ip[4]; u16 port; int n=P_sock_accept(k->h,ip,&port); if(n>=0){ P_sock_close(k->h); k->h=n; k->len=0; k->closed=0; memcpy(si+4,ip,4); si[8]=port>>8; si[9]=port; si[0]=0; si[1]=4; } }
+      else if(!k->closed && !k->listening){
+        if(k->len<SBUF-0x1000){ int n=P_sock_recv(k->h,k->buf+k->len,SBUF-k->len);
+          if(n>0){ k->len+=n; si[1]=5; si_recv(s); }
+          else if(n<0){ k->closed=1; si[0]=3; si[1]=5; } }
+      }
+    }
+    UNLOCK();
+  }
+}
+static void start_once(void){ if(!g_started){ g_started=1; for(int i=0;i<NSOCK;i++) socks[i].h=-1; P_start_worker(worker); } }
+
+static void h_netsocket(void){
+  int s; for(s=1;s<NSOCK;s++) if(socks[s].h<0) break; u8 r=0xFF;
+  if(s<NSOCK){ int h=P_sock_new(); if(h>=0){ socks[s].h=h; socks[s].len=0; socks[s].closed=0; socks[s].listening=0; si_status(s,0,0); si_recv(s); r=s; } }
+  resp1(C_NETSOCKET,r);
+}
+static void h_netconnect(void){
+  u8*d=cmdbuf+3; int s=d[0]; u8 r=0xFF;
+  if(s>=1&&s<NSOCK&&socks[s].h>=0){ u16 port=(d[5]<<8)|d[6]; /* Port in Netzwerkreihenfolge wie von der M4-Hardware gelesen */
+    /* Die M4-Beispiele senden den Port als Little-Endian-Wort (lo, hi). */
+    port=rd16(d+5);
+    if(P_sock_connect(socks[s].h,d+1,port)==0){ r=0; si_status(s,1,3); } else si_status(s,0xF1,3); }
+  resp1(C_NETCONNECT,r);
+}
+static void h_netclose(void){ int s=cmdbuf[3]; if(s>=1&&s<NSOCK&&socks[s].h>=0){ P_sock_close(socks[s].h); socks[s].h=-1; socks[s].len=0; si_status(s,0,0); si_recv(s);} resp1(C_NETCLOSE,0); }
+static void h_netsend(void){
+  u8*d=cmdbuf+3; int s=d[0]; int n=rd16(d+1); u8 r=0xFF; int avail=cmdlen-6; if(n>avail) n=avail;
+  if(s>=1&&s<NSOCK&&socks[s].h>=0){ int off=0,idle=0; r=0;
+    while(off<n){ int w=P_sock_send(socks[s].h,d+3+off,n-off); if(w<0){ r=0xFF; break; } if(w==0){ if(++idle>1000){ r=0xFF; break; } P_sleep(2);} else { off+=w; idle=0; } }
+    si_status(s,r?0xF0:0,1); }
+  resp1(C_NETSEND,r);
+}
+static void h_netrecv(void){
+  u8*d=cmdbuf+3; int s=d[0]; int want=rd16(d+1); static u8 o[0x808]; o[0]=0xFF;
+  if(want>0x800) want=0x800;
+  if(s>=1&&s<NSOCK&&socks[s].h>=0){ Sock*k=&socks[s]; int n=k->len<want?k->len:want;
+    o[0]=0; wr16(o+1,n); memcpy(o+3,k->buf,n); k->len-=n; if(k->len) memcpy(k->buf,k->buf+n,k->len); si_recv(s); respond(C_NETRECV,o,3+n); return; }
+  respond(C_NETRECV,o,3);
+}
